{
    "layer": "top",
    "position": "top",
    // "output": ["eDP-1", "DP-8"],
    "height": 34,
    "spacing": 0,
    "margin-top": 0,
    "margin-left": 0,
    "margin-right": 0,
    "margin-bottom": 0,
    "reload_style_on_change": true,

    // Choose the order of the modules
    "modules-left": [
        "custom/start-menu",
        "hyprland/workspaces",
        "custom/windowstatus",
        "custom/leftsep",
        "hyprland/window"
    ],
    "modules-center": [
    ],
    "modules-right":  [
        "custom/updates",
        "tray",
        "idle_inhibitor",
        // "custom/nightlight",
        "cpu",
        "memory",
        "temperature",
        "hyprland/language",
        "custom/power-profiles",
        "bluetooth",
        "network",
        "network#eth",
        "pulseaudio",
        "battery",
        "clock"
        // "custom/poweroff"
    ],
}
