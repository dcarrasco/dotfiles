#!/bin/bash

# Genera archivos con colores

die() { echo "generate-theme: $*" >&2; exit 1; }

state_home=${XDG_STATE_HOME:-$HOME/.local/state}
theme_state=$state_home/hypr/theme

stage_config_file() {
    local target=$1
    local staged=$theme_stage/${target##*/}

    cp "${target}.orig" "$staged" || return 1
    printf '%s\n' "$staged"
}

publish_config_file() {
    local name=$1
    local target=$2

    mv "$theme_stage/$name" "$target" || die "could not publish $target"
}

load_theme() {
    local theme_source=$1
    local parsed role color alpha alpha_hex

    command -v jq >/dev/null 2>&1 || die "jq is required to parse themes"
    parsed=$(jq -er --arg expected "$THEME_NAME" '
        def required_roles: [
            "window_active_border", "window_active_border_2", "window_active_shadow",
            "window_inactive_border", "window_inactive_shadow",
            "window_group_active_border", "window_group_inactive_border",
            "groupbar_active", "groupbar_inactive", "groupbar_text",
            "bar_bg", "tooltip_bg", "fg_normal", "fg_high", "fg_disabled",
            "accent1", "accent2", "accent3", "warning", "critical", "success",
            "window_bg", "textbox_bg", "prompt_fg", "prompt_bg",
            "placeholder_fg", "selected_bg"
        ];
        def fail($message): error($message);
        def valid_role:
            . as $role |
            ($role | type) == "string" or
            (($role | type) == "object" and
             ($role | keys | sort) == ["alpha", "color"] and
             ($role.color | type) == "string" and
             ($role.alpha | type) == "number" and
             $role.alpha >= 0 and $role.alpha <= 1);

        if type != "object" or (keys | sort) != ["name", "palette", "roles"] then
            fail("theme must contain only name, palette, and roles")
        elif .name != $expected then
            fail("theme name must match its filename")
        elif (.palette | type != "object" or length == 0) then
            fail("palette must be a non-empty object")
        elif (.palette | to_entries | all(
            .key as $key | .value as $value |
            ($key | test("^[a-z][a-z0-9_]*$")) and
            (($value | type) == "string" and ($value | test("^#[0-9A-Fa-f]{6}$")))
        ) | not) then
            fail("palette names or colors are invalid")
        elif (.roles | type != "object" or (keys | sort) != (required_roles | sort)) then
            fail("roles must contain exactly the required semantic roles")
        elif (.roles | to_entries | all(.value | valid_role) | not) then
            fail("role values must be palette names or color/alpha objects")
        else
            .palette as $palette |
            .roles | to_entries[] |
            .key as $role |
            (if (.value | type) == "string"
             then { color: .value, alpha: null }
             else .value
             end) as $value |
            if ($palette | has($value.color) | not) then
                fail("role \($role) references unknown palette color \($value.color)")
            else
                [$role, $palette[$value.color],
                 (if $value.alpha == null then "" else ($value.alpha * 256 | floor) end)] |
                @tsv
            end
        end
    ' "$theme_source") ||
        die "could not parse theme: $THEME_NAME"
    while IFS=$'\t' read -r role color alpha; do
        if [ -n "$alpha" ]; then
            printf -v alpha_hex '%02X' "$alpha"
            color=$color$alpha_hex
        fi
        printf -v "THEME_${role^^}" '%s' "$color"
    done <<< "$parsed"
}

hex_to_perc() {
    local perc=$((100 * $((0x$1)) / 255))
    echo "scale=2; $perc / 100" | bc
}

to_waybar() {
    local color=$1
    if [ ${#color} -eq 9 ]; then
        echo "alpha(${color:0:7}, $(hex_to_perc "${color:7:2}"))"
    else
        echo "${color}"
    fi
}

generate_hyprland() {
    local target=$XDG_CONFIG_HOME/hypr/lua/theme.lua
    local theme_file
    theme_file=$(stage_config_file "$target") || return 1

    sed -i \
        -e "s/^-- THEME:.*/-- THEME: ${THEME_NAME}/" \
        -e "s/\(color_active_border_1\) .*/\1 = \"${THEME_WINDOW_ACTIVE_BORDER}\",/" \
        -e "s/\(color_active_border_2\) .*/\1 = \"${THEME_WINDOW_ACTIVE_BORDER_2}\",/" \
        -e "s/\(color_inactive_border\) .*/\1 = \"${THEME_WINDOW_INACTIVE_BORDER}\",/" \
        -e "s/\(color_group_border_active\) .*/\1 = \"${THEME_WINDOW_GROUP_ACTIVE_BORDER}\",/" \
        -e "s/\(color_group_border_inactive\) .*/\1 = \"${THEME_WINDOW_GROUP_INACTIVE_BORDER}\",/" \
        -e "s/\(color_groupbar_active\) .*/\1 = \"${THEME_GROUPBAR_ACTIVE}\",/" \
        -e "s/\(color_groupbar_inactive\) .*/\1 = \"${THEME_GROUPBAR_INACTIVE}\",/" \
        -e "s/\(color_text_groupbar\) .*/\1 = \"${THEME_GROUPBAR_TEXT}\",/" \
        -e "s/\(color_shadow\) .*/\1 = \"${THEME_WINDOW_ACTIVE_SHADOW}\",/" \
        -e "s/\(color_shadow_inactive\) .*/\1 = \"${THEME_WINDOW_INACTIVE_SHADOW}\",/" \
        "$theme_file"
}

generate_hyprland_conf() {
    local target=$XDG_CONFIG_HOME/hypr/conf/theme.conf
    local theme_file
    theme_file=$(stage_config_file "$target") || return 1

    sed -i \
        -e "s/^# THEME:.*/# THEME: ${THEME_NAME}/" \
        -e "s/\(\$color_active_border_1\) .*/\1 = \"${THEME_WINDOW_ACTIVE_BORDER}\"/" \
        -e "s/\(\$color_active_border_2\) .*/\1 = \"${THEME_WINDOW_ACTIVE_BORDER_2}\"/" \
        -e "s/\(\$color_inactive_border\) .*/\1 = \"${THEME_WINDOW_INACTIVE_BORDER}\"/" \
        -e "s/\(\$color_group_border_active\) .*/\1 = \"${THEME_WINDOW_GROUP_ACTIVE_BORDER}\"/" \
        -e "s/\(\$color_group_border_inactive\) .*/\1 = \"${THEME_WINDOW_GROUP_INACTIVE_BORDER}\"/" \
        -e "s/\(\$color_groupbar_active\) .*/\1 = \"${THEME_GROUPBAR_ACTIVE}\"/" \
        -e "s/\(\$color_groupbar_inactive\) .*/\1 = \"${THEME_GROUPBAR_INACTIVE}\"/" \
        -e "s/\(\$color_text_groupbar\) .*/\1 = \"${THEME_GROUPBAR_TEXT}\"/" \
        -e "s/\(\$color_shadow\) .*/\1 = \"${THEME_WINDOW_ACTIVE_SHADOW}\"/" \
        -e "s/\(\$color_shadow_inactive\) .*/\1 = \"${THEME_WINDOW_INACTIVE_SHADOW}\"/" \
        "$theme_file"
}

generate_waybar() {
    local target=$XDG_CONFIG_HOME/waybar/colors.css
    local theme_file
    theme_file=$(stage_config_file "$target") || return 1

    sed -i \
        -e "s|^/\* THEME:.*\*/|/* THEME: ${THEME_NAME} */|" \
        -e "s/\(@define-color bg-normal\) .*/\1 $( to_waybar "$THEME_BAR_BG" );/" \
        -e "s/\(@define-color bg-tooltip\) .*/\1 $( to_waybar "$THEME_TOOLTIP_BG" );/" \
        -e "s/\(@define-color shadow\) .*/\1 $( to_waybar "$THEME_BAR_BG" );/" \
        -e "s/\(@define-color fg-normal\) .*/\1 $( to_waybar "$THEME_FG_NORMAL" );/" \
        -e "s/\(@define-color fg-high\) .*/\1 $( to_waybar "$THEME_FG_HIGH" );/" \
        -e "s/\(@define-color fg-disabled\) .*/\1 $( to_waybar "$THEME_FG_DISABLED" );/" \
        -e "s/\(@define-color accent1\) .*/\1 $( to_waybar "$THEME_ACCENT1" );/" \
        -e "s/\(@define-color accent2\) .*/\1 $( to_waybar "$THEME_ACCENT2" );/" \
        -e "s/\(@define-color accent3\) .*/\1 $( to_waybar "$THEME_ACCENT3" );/" \
        -e "s/\(@define-color warning\) .*/\1 $( to_waybar "$THEME_WARNING" );/" \
        -e "s/\(@define-color critical\) .*/\1 $( to_waybar "$THEME_CRITICAL" );/" \
        -e "s/\(@define-color success\) .*/\1 $( to_waybar "$THEME_SUCCESS" );/" \
        "$theme_file"
}

generate_rofi() {
    local target=$XDG_CONFIG_HOME/rofi/themes/colors.rasi
    local theme_file
    theme_file=$(stage_config_file "$target") || return 1

    sed -i \
        -e "s|^/\* THEME:.*\*/|/* THEME: ${THEME_NAME} */|" \
        -e "s/\(window-border:\) .*/\1 ${THEME_WINDOW_ACTIVE_BORDER};/" \
        -e "s/\(bg-color:\) .*/\1 ${THEME_WINDOW_BG};/" \
        -e "s/\(foreground:\) .*/\1 ${THEME_FG_NORMAL};/" \
        -e "s/\(bg-textbox:\) .*/\1 ${THEME_TEXTBOX_BG};/" \
        -e "s/\(fg-prompt:\) .*/\1 ${THEME_PROMPT_FG};/" \
        -e "s/\(bg-prompt:\) .*/\1 ${THEME_PROMPT_BG};/" \
        -e "s/\(fg-placeholder:\) .*/\1 ${THEME_PLACEHOLDER_FG};/" \
        -e "s/\(fg-selected:\) .*/\1 ${THEME_ACCENT1};/" \
        -e "s/\(bg-selected:\) .*/\1 ${THEME_SELECTED_BG};/" \
        -e "s/\(fg-scrollbar:\) .*/\1 ${THEME_PLACEHOLDER_FG};/" \
        "$theme_file"
}

[ $# -eq 1 ] || die "usage: generate-theme <name>"
THEME_NAME=$1
[[ $THEME_NAME =~ ^[a-z0-9-]+$ ]] || die "invalid theme name: $THEME_NAME"
theme_source=$XDG_CONFIG_HOME/hypr/themes/$THEME_NAME.json
[ -f "$theme_source" ] || die "unknown theme: $THEME_NAME (no such file: $theme_source)"
load_theme "$theme_source"

theme_stage=$(mktemp -d "$XDG_CONFIG_HOME/.hypr-theme.XXXXXX") || die "could not create staging directory"
trap 'rm -rf -- "$theme_stage"' EXIT

generate_hyprland || die "could not generate Hyprland Lua theme"
generate_hyprland_conf || die "could not generate native Hyprland theme"
generate_waybar || die "could not generate Waybar theme"
generate_rofi || die "could not generate Rofi theme"

publish_config_file theme.lua "$XDG_CONFIG_HOME/hypr/lua/theme.lua"
publish_config_file theme.conf "$XDG_CONFIG_HOME/hypr/conf/theme.conf"
publish_config_file colors.css "$XDG_CONFIG_HOME/waybar/colors.css"
publish_config_file colors.rasi "$XDG_CONFIG_HOME/rofi/themes/colors.rasi"

mkdir -p "${theme_state%/*}" || die "could not create theme state directory"
printf '%s\n' "$THEME_NAME" > "$theme_state" || die "could not record current theme"

# vim: set ft=sh:
