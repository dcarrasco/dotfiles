#!/bin/bash

set -euo pipefail

declare -A PALETTE=()
declare -A THEME=()

THEME_NAME=
THEME_STAGE=

readonly CONFIG_HOME=${XDG_CONFIG_HOME:-$HOME/.config}
readonly STATE_HOME=${XDG_STATE_HOME:-$HOME/.local/state}
readonly THEME_STATE=$STATE_HOME/hypr/theme

readonly -a REQUIRED_ROLES=(
    border_active
    border_active_alt
    border_inactive
    border_group
    shadow
    groupbar_active
    groupbar_inactive
    groupbar_text
    bg_window
    bg_tooltip
    bg_textbox
    bg_selected
    text
    text_high
    text_disabled
    accent1
    accent2
    accent3
    warning
    critical
    success
)

die() {
    notify-send -u critical -t 0 -i dialog-warning 'ERROR: hypr-generate theme: ' "$*"
    printf "ERROR - generate-theme: %s\n" "$*" >&2; exit 1;
}

create_stage() {
    THEME_STAGE=$(mktemp -d "$CONFIG_HOME/hypr/.hypr-theme.XXXXXX") || die "could not create staging directory"

    trap 'rm -rf -- "$THEME_STAGE"' EXIT
}

stage_config_file() {
    local target=$1
    local staged=$THEME_STAGE/${target##*/}

    cp "$target.orig" "$staged" || die "could not stage template: $target.orig"

    printf '%s' "$staged"
}

publish_config_file() {
    local staged_name=$1
    local target=$2

    mv -f "$THEME_STAGE/$staged_name" "$target" || die "could not publish generated theme: $target"
}

publish_theme() {
    publish_config_file theme.lua   "$CONFIG_HOME/hypr/lua/theme.lua"
    publish_config_file theme.conf  "$CONFIG_HOME/hypr/conf/theme.conf"
    publish_config_file colors.css  "$CONFIG_HOME/waybar/colors.css"
    publish_config_file colors.rasi "$CONFIG_HOME/rofi/themes/colors.rasi"
}

validate_theme() {
    local role
    for role in "${REQUIRED_ROLES[@]}"; do
        [[ -v "THEME[$role]" ]] || die "missing theme role: ${role,,}"
    done
}

alpha_to_hex() {
    local alpha=$1
    local hex

    hex=$(
        awk -v alpha="$alpha" '
            BEGIN {
                if (alpha !~ /^(0([.][0-9]+)?|1([.]0+)?)$/)
                    exit 1;
                printf "%02X", int(alpha * 255 + 0.5);
            }'
    ) || die "invalid alpha value: $alpha"

    printf "%s" "$hex"
}

hex_to_decimal() {
    local hex=$1
    local decimal=$((16#$hex))

    awk -v decimal="$decimal" 'BEGIN { printf "%.2f", decimal / 255 }'
}

to_waybar() {
    local color=$1
    if [ ${#color} -eq 9 ]; then
        printf "alpha(%s, %s)" "${color:0:7}" "$(hex_to_decimal "${color:7:2}")"
    else
        printf "%s" "${color}"
    fi
}

palette_color() {
    local name=$1

    [[ -v "PALETTE[$name]" ]] || die "unknown palette color: $name"
    printf "%s" "${PALETTE[$name]}"
}

process_palette() {
    local theme=$1
    local palette color_name color

    palette="$(jq -r '.palette | to_entries[] | [ .key, .value ] | @tsv' "$theme")"

    while IFS=$'\t' read -r color_name color; do
        PALETTE[$color_name]=$color
    done <<< "$palette"
}

process_roles() {
    local theme_file=$1
    local plain_colors alpha_colors
    local role_name color_name alpha

    # process plain colors
    plain_colors="$(jq -r '.roles | to_entries[] | select (.value | type == "string") | [ .key, .value ] | @tsv' "$theme_file")"

    while ifs=$'\t' read -r role_name color_name; do
        THEME[$role_name]="$(palette_color "$color_name")"
    done <<< "$plain_colors"

    # process alpha colors
    alpha_colors="$( jq -r '.roles | to_entries[] | select (.value | type == "object") | [ .key, .value.color, .value.alpha ] | @tsv' "$theme_file")"

    while ifs=$'\t' read -r role_name color_name alpha; do
        THEME[$role_name]="$(palette_color "$color_name")$(alpha_to_hex "$alpha")"
    done <<< "$alpha_colors"
}

generate_hyprland() {
    local target=$CONFIG_HOME/hypr/lua/theme.lua
    local staged
    staged=$(stage_config_file "$target")

    sed -i -E \
        -e "s/^-- THEME:.*/-- THEME: $THEME_NAME/"                                   \
        -e "s/(color_active_border_1) .*/\1 = \"${THEME[border_active]}\",/"         \
        -e "s/(color_active_border_2) .*/\1 = \"${THEME[border_active_alt]}\",/"     \
        -e "s/(color_inactive_border) .*/\1 = \"${THEME[border_inactive]}\",/"       \
        -e "s/(color_group_border_active) .*/\1 = \"${THEME[border_group]}\",/"      \
        -e "s/(color_group_border_inactive) .*/\1 = \"${THEME[border_inactive]}\",/" \
        -e "s/(color_groupbar_active) .*/\1 = \"${THEME[groupbar_active]}\",/"       \
        -e "s/(color_groupbar_inactive) .*/\1 = \"${THEME[groupbar_inactive]}\",/"   \
        -e "s/(color_text_groupbar) .*/\1 = \"${THEME[groupbar_text]}\",/"           \
        -e "s/(color_shadow) .*/\1 = \"${THEME[shadow]}\",/"                         \
        -e "s/(color_shadow_inactive) .*/\1 = \"${THEME[shadow]}\",/"                \
        "$staged"
}

generate_hyprland_conf() {
    local target=$CONFIG_HOME/hypr/conf/theme.conf
    local staged
    staged=$(stage_config_file "$target")

    sed -i -E \
        -e "s/^# THEME:.*/# THEME: $THEME_NAME/"                                          \
        -e "s/(\$color_active_border_1) .*/\1 = \"${THEME[border_active]}\"/"             \
        -e "s/(\$color_active_border_2) .*/\1 = \"${THEME[border_active_alt]}\"/"         \
        -e "s/(\$color_inactive_border) .*/\1 = \"${THEME[border_inactive]}\"/"           \
        -e "s/(\$color_group_border_active) .*/\1 = \"${THEME[border_group]}\"/"          \
        -e "s/(\$color_group_border_inactive) .*/\1 = \"${THEME[border_inactive]}\"/"     \
        -e "s/(\$color_groupbar_active) .*/\1 = \"${THEME[groupbar_active]}\"/"           \
        -e "s/(\$color_groupbar_inactive) .*/\1 = \"${THEME[groupbar_inactive]}\"/"       \
        -e "s/(\$color_text_groupbar) .*/\1 = \"${THEME[groupbar_text]}\"/"               \
        -e "s/(\$color_shadow) .*/\1 = \"${THEME[shadow]}\"/"                             \
        -e "s/(\$color_shadow_inactive) .*/\1 = \"${THEME[shadow]}\"/"                    \
        "$staged"
}

generate_waybar() {
    local target=$CONFIG_HOME/waybar/colors.css
    local staged
    staged=$(stage_config_file "$target")

    sed -i -E \
        -e "s|^/\* THEME:.*\*/|/* THEME: $THEME_NAME */|"                                   \
        -e "s/(@define-color bg-normal) .*/\1 $( to_waybar "${THEME[bg_window]}" );/"       \
        -e "s/(@define-color bg-tooltip) .*/\1 $( to_waybar "${THEME[bg_tooltip]}" );/"     \
        -e "s/(@define-color shadow) .*/\1 $( to_waybar "${THEME[shadow]}" );/"             \
        -e "s/(@define-color fg-normal) .*/\1 $( to_waybar "${THEME[text]}" );/"            \
        -e "s/(@define-color fg-high) .*/\1 $( to_waybar "${THEME[text_high]}" );/"         \
        -e "s/(@define-color fg-disabled) .*/\1 $( to_waybar "${THEME[text_disabled]}" );/" \
        -e "s/(@define-color accent1) .*/\1 $( to_waybar "${THEME[accent1]}" );/"           \
        -e "s/(@define-color accent2) .*/\1 $( to_waybar "${THEME[accent2]}" );/"           \
        -e "s/(@define-color accent3) .*/\1 $( to_waybar "${THEME[accent3]}" );/"           \
        -e "s/(@define-color warning) .*/\1 $( to_waybar "${THEME[warning]}" );/"           \
        -e "s/(@define-color critical) .*/\1 $( to_waybar "${THEME[critical]}" );/"         \
        -e "s/(@define-color success) .*/\1 $( to_waybar "${THEME[success]}" );/"           \
        "$staged"
}

generate_rofi() {
    local target=$CONFIG_HOME/rofi/themes/colors.rasi
    local staged
    staged=$(stage_config_file "$target")

    sed -i -E \
        -e "s|^/\* THEME:.*\*/|/* THEME: $THEME_NAME */|"         \
        -e "s/(window-border:) .*/\1 ${THEME[border_active]};/"   \
        -e "s/(bg-color:) .*/\1 ${THEME[bg_window]};/"            \
        -e "s/(foreground:) .*/\1 ${THEME[text]};/"               \
        -e "s/(bg-textbox:) .*/\1 ${THEME[bg_textbox]};/"         \
        -e "s/(fg-prompt:) .*/\1 ${THEME[accent1]};/"             \
        -e "s/(bg-prompt:) .*/\1 ${THEME[bg_window]};/"           \
        -e "s/(fg-placeholder:) .*/\1 ${THEME[text_disabled]};/"  \
        -e "s/(fg-selected:) .*/\1 ${THEME[accent1]};/"           \
        -e "s/(bg-selected:) .*/\1 ${THEME[bg_selected]};/"       \
        -e "s/(fg-scrollbar:) .*/\1 ${THEME[text_disabled]};/"    \
        "$staged"
}



main() {
    local theme_file

    THEME_NAME=$1
    [[ $THEME_NAME =~ ^[a-z0-9-]+$ ]] || die "invalid theme name: $THEME_NAME"

    theme_file="$CONFIG_HOME/hypr/themes/${THEME_NAME}.json"
    [[ -f "$theme_file" ]] || die "unknown theme: $THEME_NAME (no such file: $theme_file)"
    jq empty "$theme_file" || die "invalid json file: $theme_file"

    process_palette "$theme_file"
    process_roles   "$theme_file"
    validate_theme

    create_stage
    generate_hyprland
    generate_hyprland_conf
    generate_waybar
    generate_rofi
    publish_theme

    mkdir -p "${THEME_STATE%/*}" || die "could not create theme state directory"
    printf '%s\n' "$THEME_NAME" > "$THEME_STATE" || die "could not record current theme"
}


[ $# -eq 1 ] || die "usage: generate-theme <name>"

main "$1"
