#!/usr/bin/env bash

current_profile() {
    tuned-adm active | sed -n 's/Current active profile: //p'
}

on_battery() {
    upower -d | sed -n 's/^[[:space:]]*on-battery:[[:space:]]//p'
}

power_profile=$(current_profile)
echo "Current profile: $power_profile"

[[ "$(on_battery)" == yes ]] && balanced_profile="balanced-battery" || balanced_profile="balanced"

case "$power_profile" in
    "$balanced_profile")     tuned-adm profile throughput-performance ;;
    throughput-performance)  tuned-adm profile powersave ;;
    powersave)               tuned-adm profile "$balanced_profile" ;;
    *)                       tuned-adm profile "$balanced_profile" ;;
esac

notify-send -u low "Power Management" "New profile: $(current_profile)"
