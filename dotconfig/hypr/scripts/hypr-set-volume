#!/usr/bin/env bash

notify() {
    local icon="$1"
    local message="$2"
    local volume="${3:-}"

    if [[ -n "$volume" ]]; then
        notify-send -c OSD -h "int:value:$volume" -i "$icon" '' "Volumen ($volume%)"
    else
        notify-send -c OSD -i "$icon" '' "$message"
    fi
}

step=""
icon=""
case $1 in
    up)
        step="5%+"
        icon="audio-volume-high"
        ;;
    down)
        step="5%-"
        icon="audio-volume-low"
        ;;
    toggle)
        amixer set Master toggle
        new_status="$(amixer get Master | sed -nE "s/ *Front Left.*\[(on|off)\].*/\1/p")"

        if [[ $new_status == "off" ]]; then
            notify audio-volume-muted "Volumen Mute"
        else
            notify audio-volume-high "Volumen Unmute"
        fi
        ;;
    toggle-mic)
        amixer set Capture toggle
        new_status="$(amixer get Capture | grep "Front Left:" | sed -E "s/.*\[(on|off)\].*/\1/")"

        if [[ $new_status == "off" ]]; then
            notify mic-volume-muted "Volumen Mute"
        else
            notify mic-volume-high "Volumen Unmute"
        fi
        ;;
esac

if [[ -n "$step" ]]; then
    amixer set Master "$step"
    volume="$(amixer get Master | grep "Front Left:" | cut -d [ -f 2 | cut -d % -f 1)"

    notify "$icon" "Volumen ($volume%)" "$volume"
fi
