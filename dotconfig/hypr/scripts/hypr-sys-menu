#!/usr/bin/env bash

set -euo pipefail

declare -xr CONFIG_HOME=${XDG_CONFIG_HOME:-$HOME/.config}

TERMINAL=kitty
SCRIPT_PATH=$CONFIG_HOME/hypr/scripts
SELF=$SCRIPT_PATH/hypr-sys-menu
MENU_FILE=$SCRIPT_PATH/sys-menu.jsonc

export PATH="$SCRIPT_PATH:$PATH"

die() {
    printf 'ERROR: %s\n' "$*" >&2
    notify-send -u critical -t 0 -i dialog-warning 'ERROR: hypr-sys-menu' "$*"
    exit 1
}

debug() {
    [[ ${HYPR_SYS_MENU_DEBUG:-false} == true ]] || return 0
    printf 'DEBUG: %s\n' "$*" >&2
}

exec_pgm() {
    coproc {
        "$@" > /dev/null 2>&1
    }
    exit 0
}

terminal() {
    local command=$*

    "$TERMINAL" --class hypr-terminal-float --title Fedora bash -c -- "$command"
}

present_terminal() {
    local command=$1

    terminal "hypr-show-logo; $command; hypr-show-done"
}

edit_file() {
    local file=$1

    notify-send -u low 'Editing config file' "$file"
    "$TERMINAL" nvim "$file"
}

webapp() {
    local url=$1

    brave-browser --password-store=basic --new-window --app="$url"
}

entry() {
    local label=$1
    local action=$2
    local checked=${3:-}

    if [[ -n $checked ]] && (eval "$checked"); then
        label+=' '
    fi

    printf '%s\0info\x1f%s\n' "$label" "$action"
}

selectable_entry() {
    local label=$1
    local info=$2
    local selected=${3:-false}

    local checked=' '
    [[ $selected == true ]] && checked=' '

    entry "$checked $label" "$info" ''
}

title_case() {
    sed -E \
        -e 's/^([[:lower:]])/\U\1/'  \
        -e 's/-([[:lower:]])/ \U\1/g' \
        <<< "$1"
}

bar_layout_entries() {
    local menu_item=$1
    local current_layout layout
    local -a layouts=()

    current_layout="$(hypr-switch-bar-layout --current)"
    mapfile -t layouts < <(hypr-switch-bar-layout --get-layouts )

    for layout in "${layouts[@]}"; do
        local selected=false
        [[ $layout == "$current_layout" ]] && selected=true

        selectable_entry \
            "${layout^}" \
            "act:$menu_item:$layout" \
            "$selected"
    done
}

theme_colors_entries() {
    local menu_item=$1
    local current_theme theme_name
    local -a themes=()

    current_theme="$(hypr-switch-colors --current)"
    mapfile -t themes < <(hypr-switch-colors --get-themes)

    for theme_name in "${themes[@]}"; do
        local selected=false
        [[ $theme_name == "$current_theme" ]] && selected=true

        selectable_entry \
            "$(title_case "$theme_name")" \
            "act:$menu_item:$theme_name" \
            "$selected"
    done
}

font_entries() {
    local menu_item=$1
    local current_font font
    local -a fonts=()

    current_font="$(hypr-switch-font --current)"
    mapfile -t fonts < <(hypr-switch-font --get-fonts)

    for font in "${fonts[@]}"; do
        local selected=false
        [[ $font == "$current_font" ]] && selected=true

        selectable_entry \
            "<span size=\"small\" font_family=\"$font\">$font</span>" \
            "act:$menu_item:$font" \
            "$selected"
    done
}

pm_entries() {
    local menu_item=$1
    local current_pm pm
    local -a profiles=(
        balanced
        balanced-battery
        throughput-performance
        powersave
    )

    current_pm="$(tuned-adm active | sed 's/^Current active profile: //')"

    for pm in "${profiles[@]}"; do
        local selected=false
        [[ $pm == "$current_pm" ]] && selected=true

        selectable_entry \
            "$(title_case "$pm")" \
            "act:$menu_item:$pm" \
            "$selected"
    done

}

render_parent_menu() {
    local current_menu=${ROFI_DATA:-main}

    [[ $current_menu == 'main' ]] && exit 0

    local parent_menu=${current_menu%.*}
    [[ $parent_menu == "$current_menu" ]] && parent_menu='main'

    render "$parent_menu"
}

menu_query() {
    sed '/^[[:space:]]*\/\//d' "$MENU_FILE" |
        jq -r "$@" || die "menu json file not parseable: $MENU_FILE"
}

process_menu() {
    local menu=$1

    debug "process_menu: menu: $menu"

    # shellcheck disable=SC2016 # $menu is a jq variable.
    menu_query --arg menu "$menu" '
        to_entries[]
        | select(
            if $menu == "main" then
                (.key | contains(".") | not)
            else
                (.key | startswith($menu + ".")) and (.key | ltrimstr($menu + ".") | contains(".") | not)
            end
        )
        | [
            .key,
            (.value.icon // ""),
            (.value.label // ""),
            (.value.action // "" | tostring),
            (.value.options // ""),
            (.value.checked // "")
        ]
        | join("\u001e")'
}

menu_title() {
    local menu=$1

    # shellcheck disable=SC2016 # $menu is a jq variable.
    menu_query --arg menu "$menu" '.[$menu].label // empty'
}

render() {
    local menu_item=${1:-main}
    local title rows

    title=$(menu_title "$menu_item")
    rows=$(process_menu "$menu_item")

    printf '\0prompt\x1f%s\n' "${title:-Start}"
    printf '\0no-custom\x1ftrue\n'
    printf '\0markup-rows\x1ftrue\n'
    printf '\0data\x1f%s\n' "$menu_item"
    printf '\0use-hot-keys\x1ftrue\n'

    while IFS=$'\x1e' read -r name icon label action options checked; do
        debug "RENDER: name: $name  icon: $icon  label: $label  action: $action  options: $options  checked: $checked"
        if [[ -n $options ]]; then
            entry "$icon  $label" "opt:$name" "$checked"
        elif [[ -n $action && -z $options ]]; then
            entry "$icon  $label" "act:$name" "$checked"
        else
            entry "$icon  $label" "menu:$name" "$checked"
        fi
    done <<< "$rows"
}

run_action() {
    local menu_item=$1
    local menu_key=${menu_item%%:*}
    local i action_text
    local -a action=()

    # shellcheck disable=SC2016 # $menu is a jq variable.
    action_text=$(menu_query --arg menu "$menu_key" '
        .[$menu].action
        |   if type != "array" then
                error("action must be an array")
            elif length == 0 then
                error("action must not be empty")
            elif (all(.[]; type == "string") | not) then
                error("action arguments must be string")
            elif .[0] == "" then
                error("action command must not be empty")
            else
                .[]
            end
    ') || die "invalid action: $menu_key"

    mapfile -t action <<< "$action_text"

    for i in "${!action[@]}"; do
        [[ ${action[$i]} == *'$'* ]] || continue
        action[i]=$(printf '%s' "${action[i]}" | envsubst) || die "cannot expand action: $menu_key"
    done

    if [[ $menu_item == *:* ]]; then
        action+=("${menu_item#*:}")
    fi

    debug "RUN ACTION: ${action[*]}"

    exec_pgm "${action[@]}"
}

render_options() {
    local menu_item=$1
    local options_cmd

    # shellcheck disable=SC2016 # $menu is a jq variable.
    options_cmd=$(menu_query --arg menu "$menu_item" '.[$menu].options')

    declare -F "$options_cmd" >/dev/null || die "invalid options function: $options_cmd"

    "$options_cmd" "$menu_item"
}

handle_selection() {
    local info="${ROFI_INFO:-}"

    case $info in
        menu:*)  render         "${info#menu:}" ;;
        act:*)   run_action     "${info#act:}"  ;;
        opt:*)   render_options "${info#opt:}"  ;;
        *)       die "invalid rofi entry data: $info"
    esac
}

load_rofi() {
    local -r font='Hack Nerd Font 16'
    local -r theme='entry{placeholder:"Search...";} window{width:22%;}'

    rofi \
        -show sysmenu \
        -modes "sysmenu:$SELF" \
        -i \
        -format p \
        -theme-str "$theme" \
        -font "$font" \
        -kb-cancel "Control+g,Control+Escape" \
        -kb-custom-1 "Escape"
}

main() {
    local initial_menu=${1:-main}

    if [[ -z ${ROFI_RETV:-} ]]; then
        export INI_MENU="$initial_menu"
        load_rofi
        return
    fi

    case $ROFI_RETV in
        0)   render "${INI_MENU:-main}" ;;
        1)   handle_selection ;;
        10)  render_parent_menu ;;
        *)   die "Unexpected Rofi return value: $ROFI_RETV" ;;
    esac
}

main "$@"
