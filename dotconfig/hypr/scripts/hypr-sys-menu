#!/bin/bash

set -euo pipefail

readonly TERMINAL=kitty
readonly CONFIG_HOME=${XDG_CONFIG_HOME:-$HOME/.config}
readonly SCRIPT_PATH=$CONFIG_HOME/hypr/scripts
readonly SELF=$SCRIPT_PATH/hypr-sys-menu

export PATH="$SCRIPT_PATH:$PATH"

declare -Ar MENU_TITLES=(
    [main]="Start"
    [style]="Style"
    [bar_layout]="Bar Layout"
    [theme_colors]="Colors"
    [style_fonts]="Fonts"
    [learn]="Learn"
    [trigger]="Trigger"
    [capture]="Capture"
    [screenshot]="Screenshot"
    [screenrecord]="Screenrecord"
    [toggle]="Toggle"
    [power_management]="Power Management"
    [setup]="Setup"
    [update]="Update"
    [system]="System"
)

declare -Ar MENU_PARENTS=(
    [style]="main"
    [bar_layout]="style"
    [theme_colors]="style"
    [style_fonts]="style"
    [learn]="main"
    [trigger]="main"
    [capture]="trigger"
    [screenshot]="capture"
    [screenrecord]="capture"
    [toggle]="trigger"
    [power_management]="toggle"
    [setup]="main"
    [update]="main"
    [system]="main"
)

die() {
    printf "ERROR: %s\n" "$*" >&2
    notify-send -u critical -t 0 -i dialog-warning "ERROR: hypr-sys-menu" "$*"
    exit 1
}

exec_pgm() {
    coproc {
        "$@" > /dev/null 2>&1
    }
    exit 0
}

terminal() {
    local command=$*

    exec_pgm "$TERMINAL" --class hypr-terminal-float --title Fedora bash -c -- "$command"
}

present_terminal() {
    local command=$1

    terminal "hypr-show-logo; $command; hypr-show-done"
}

edit_file() {
    local file=$1
    notify-send -u low "Editing config file" "$file"
    exec_pgm "$TERMINAL" nvim "$file"
}

webapp() {
    local url=$1
    exec_pgm brave-browser --password-store=basic --new-window --app="$url"
}

entry() {
    printf '%s\0info\x1f%s\n' "$1" "$2"
}

selectable_entry() {
    local label=$1
    local info=$2
    local selected=${3:-false}

    local checked=" "
    [[ $selected == true ]] && checked=" "

    entry "$checked $label" "$info"
}

bar_layouts_entries() {
    local current_layout layout
    local -a layouts=()

    current_layout="$(hypr-switch-bar-layout --current)"
    mapfile -t layouts < <(hypr-switch-bar-layout --get-layouts )

    for layout in "${layouts[@]}"; do
        selectable_entry \
            "${layout^}" \
            "act:style_bar_layout:$layout" \
            "$([[ $layout == "$current_layout" ]] && printf true || printf false)"
    done
}

theme_colors_entries() {
    local current_theme theme_name
    local -a themes=()

    current_theme="$(hypr-switch-colors --current)"
    mapfile -t themes < <(hypr-switch-colors --get-themes)

    for theme_name in "${themes[@]}"; do
        selectable_entry \
            "$(sed -E 's/^([a-z])/\U\1/; s/-([a-z])/ \U\1/g' <<< "$theme_name")" \
            "act:style_colors:$theme_name" \
            "$([[ $theme_name == "$current_theme" ]] && printf true || printf false)"
    done
}

font_entries() {
    local current_font font
    local -a fonts=()

    current_font="$(hypr-switch-font --current)"
    mapfile -t fonts < <(hypr-switch-font --get-fonts)

    for font in "${fonts[@]}"; do
        selectable_entry \
            "<span size=\"small\" font_family=\"$font\">$font</span>" \
            "act:style_font:$font" \
            "$([[ $font == "$current_font" ]] && printf true || printf false)"
    done
}

render_parent() {
    local current_menu=${ROFI_DATA:-main}
    local parent_menu=${MENU_PARENTS[$current_menu]:-}

    [[ -n $parent_menu ]] || exit 0
    render "$parent_menu"
}

render() {
    local menu=$1
    local title=${MENU_TITLES[$menu]-}

    [[ -n $title ]] || die "cannot render unknown menu title: $menu"

    printf '\0prompt\x1f%s\n' "$title"
    printf '\0no-custom\x1ftrue\n'
    printf '\0markup-rows\x1ftrue\n'
    printf '\0data\x1f%s\n' "$menu"
    printf '\0use-hot-keys\x1ftrue\n'

    case "$menu" in
        main)
            entry "󰀻  Apps"     "act:apps"
            entry "  Search"   "act:search"
            entry "  Style"    "menu:style"
            entry "  Learn"    "menu:learn"
            entry "󱓞  Trigger"  "menu:trigger"
            entry "  Setup"    "menu:setup"
            entry "  Update"   "menu:update"
            entry "  About"    "act:about"
            entry "  System"   "menu:system"
            ;;
        style)
            entry "  Bar Layout"           "menu:bar_layout"
            entry "󰸌  Colors"               "menu:theme_colors"
            entry "  Font"                 "menu:style_fonts"
            entry "  Background"           "act:style_background"
            entry "  Random Background"    "act:style_random_bg"
            entry "  Hyprland"             "act:style_hyprland"
            ;;
        bar_layout)
            bar_layouts_entries
            ;;
        theme_colors)
            theme_colors_entries
            ;;
        style_fonts)
            font_entries
            ;;
        learn)
            entry "  Keybindings"  "act:learn_keybindings"
            entry "  Omarchy"      "act:learn_omarchy"
            entry "  Hyprland"     "act:learn_hyprland"
            entry "  Waybar"       "act:learn_waybar"
            entry "  NerdFonts"    "act:learn_nerdfonts"
            entry "󰣇  Arch"         "act:learn_arch"
            entry "  Neovim"       "act:learn_neovim"
            entry "󱆃  Bash"         "act:learn_bash"
            entry "  Tmux"         "act:learn_tmux"
            ;;
        trigger)
            entry "  Capture"  "menu:capture"
            entry "  Toggle"   "menu:toggle"
            ;;
        capture)
            entry "  Screenshot"       "menu:screenshot"
            entry "  Screenrecord"     "menu:screenrecord"
            entry "󰃉  Color"            "act:capture_color"
            ;;
        screenshot)
            entry "󰩬  Region to clipboard"     "act:screenshot_region_clip"
            entry "󰩬  Region to file"          "act:screenshot_region_file"
            entry "󰹑  Display to clipboard"    "act:screenshot_display_clip"
            entry "󰹑  Display to file"         "act:screenshot_display_file"
            ;;
        screenrecord)
            entry "󰩬  Region"   "act:screenrecord_region"
            entry "󰹑  Display"  "act:screenrecord_display"
            ;;
        toggle)
            entry "  Wifi"                     "act:toggle_wifi"
            entry "󰂯  Bluetooth"                "act:toggle_bluetooth"
            entry "  Power Management"         "menu:power_management"
            entry "  Keyboard Layout"          "act:toggle_kb_layout"
            entry "󰪛  Keyboard ControlCaps"     "act:toggle_controlcaps"
            entry "󱄄  Screensaver"              "act:toggle_screensaver"
            entry "󰔎  Nightlight"               "act:toggle_nightlight"
            entry "󱫖  Idle Lock"                "act:toggle_idle"
            entry "󰍜  Top Bar"                  "act:toggle_topbar"
            ;;
        power_management)
            entry "  Balanced"             "act:pm_balanced"
            entry "  Balanced Battery"     "act:pm_balanced_battery"
            entry "  Performance"          "act:pm_performance"
            entry "  Power Saver"          "act:pm_powersaver"
            ;;
        setup)
            entry "  Configs"      "act:setup_configs"
            entry "  Audio"        "act:setup_audio"
            entry "  Wifi"         "act:setup_wifi"
            entry "󰂯  Bluetooth"    "act:setup_bluetooth"
            entry "󰍹  Monitors"     "act:setup_monitors"
            entry "󰐪  Printers"     "act:setup_printers"
            entry "  Keybindings"  "act:setup_keybindings"
            entry "  Input"        "act:setup_input"
            entry "󰈷  Fingerprint"  "act:setup_fingerprint"
            entry "  Fido2"        "act:setup_fido2"
            ;;
        update)
            entry "  Update"               "act:update_run"
            entry "󰉉  Install package"      "act:update_install"
            entry "󰭌  Remove package"       "act:update_remove"
            ;;
        system)
            entry "  Lock"          "act:system_lock"
            entry "󰗽  Logout"        "act:system_logout"
            entry "  Suspend"       "act:system_suspend"
            entry "  Reboot"        "act:system_reboot"
            entry "󰐥  Power Off"     "act:system_poweroff"
            ;;
        *)
            die "cannot render unknown menu: $menu"
            ;;
    esac
}

run_action() {
    case "$1" in
        apps)                   exec_pgm rofi -i -show drun -show-icons -theme layout-apps ;;
        search)                 exec_pgm hypr-search-home ;;
        about)                  terminal "fastfetch; hypr-show-done" ;;

        style_bar_layout:*)     exec_pgm hypr-switch-bar-layout --set "${1#style_bar_layout:}" ;;
        style_colors:*)         exec_pgm hypr-switch-colors --set "${1#style_colors:}" ;;
        style_font:*)           exec_pgm hypr-switch-font --set "${1#style_font:}" ;;
        style_background)       exec_pgm hypr-switch-wallpaper ;;
        style_random_bg)        exec_pgm hypr-switch-wallpaper random ;;
        style_hyprland)         edit_file "$CONFIG_HOME/hypr/lua/looknfeel.lua" ;;

        learn_keybindings)      exec_pgm hypr-show-keybinds ;;
        learn_omarchy)          webapp "https://manuals.omamix.org/2/the-omarchy-manual" ;;
        learn_hyprland)         webapp "https://wiki.hypr.land/" ;;
        learn_waybar)           webapp "https://github.com/Alexays/Waybar/wiki" ;;
        learn_nerdfonts)        webapp "https://www.nerdfonts.com/cheat-sheet" ;;
        learn_arch)             webapp "https://wiki.archlinux.org/title/Main_page" ;;
        learn_neovim)           webapp "https://www.lazyvim.org/keymaps" ;;
        learn_bash)             webapp "https://devhints.io/bash" ;;
        learn_tmux)             webapp "https://tmuxcheatsheet.com/" ;;

        capture_color)          exec_pgm hyprpicker -a ;;

        screenshot_region_clip)     exec_pgm hypr-cmd-screenshot clipboard ;;
        screenshot_region_file)     exec_pgm hypr-cmd-screenshot region ;;
        screenshot_display_clip)    exec_pgm hypr-cmd-screenshot clipboard ;;
        screenshot_display_file)    exec_pgm hypr-cmd-screenshot file ;;

        screenrecord_region)    exec_pgm "$OMARCHY_BIN_PATH/omarchy-cmd-screenrecord" ;;
        screenrecord_display)   exec_pgm "$OMARCHY_BIN_PATH/omarchy-cmd-screenrecord" output ;;

        toggle_wifi)            exec_pgm hypr-switch-wifi ;;
        toggle_bluetooth)       exec_pgm hypr-bluetooth --toggle ;;
        toggle_kb_layout)       exec_pgm hypr-switch-keyboard-layout ;;
        toggle_controlcaps)     exec_pgm hypr-switch-controlcaps ;;
        toggle_screensaver)     exec_pgm "$OMARCHY_BIN_PATH/omarchy-launch-screensaver" ;;
        toggle_nightlight)      exec_pgm hypr-switch-nightlight ;;
        toggle_idle)            exec_pgm "$OMARCHY_BIN_PATH/omarchy-toggle-idle" ;;
        toggle_topbar)          exec_pgm pkill -SIGUSR1 waybar ;;

        pm_balanced)            exec_pgm tuned-adm profile balanced ;;
        pm_balanced_battery)    exec_pgm tuned-adm profile balanced-battery ;;
        pm_performance)         exec_pgm tuned-adm profile throughput-performance ;;
        pm_powersaver)          exec_pgm tuned-adm profile powersave ;;

        setup_configs)          exec_pgm hypr-edit-config ;;
        setup_audio)            terminal wiremix ;;
        setup_wifi)             exec_pgm hypr-nmcli-rofi ;;
        setup_bluetooth)        exec_pgm blueman-manager ;;
        setup_monitors)         exec_pgm hypr-switch-monitor ;;
        setup_printers)         webapp "http://localhost:631" ;;
        setup_keybindings)      if [[ "$DESKTOP_SESSION" = "bspwm" ]]; then
                                    edit_file "$CONFIG_HOME/sxhkd/sxhkdrc";
                                else
                                    edit_file "$CONFIG_HOME/hypr/lua/keybinds.lua";
                                fi
                                ;;
        setup_input)            edit_file "$CONFIG_HOME/hypr/lua/input.lua" ;;
        setup_fingerprint)      terminal "$OMARCHY_BIN_PATH/omarchy-setup-fingerprint" ;;
        setup_fido2)            terminal "$OMARCHY_BIN_PATH/omarchy-setup-fido2" ;;

        update_run)             present_terminal hypr-do-update ;;
        update_install)         terminal "hypr-pkg-install; hypr-show-done" ;;
        update_remove)          terminal "hypr-pkg-remove; hypr-show-done" ;;

        system_lock)            exec_pgm hyprlock ;;
        system_logout)          exec_pgm loginctl terminate-user "$USER" ;;
        system_suspend)         exec_pgm systemctl suspend ;;
        system_reboot)          exec_pgm systemctl reboot ;;
        system_poweroff)        exec_pgm systemctl poweroff ;;

        *)                      die "unknown action: $1" ;;
    esac
}

handle_selection() {
    local info="${ROFI_INFO:-}"

    case $info in
        menu:*)  render     "${ROFI_INFO#menu:}" ;;
        act:*)   run_action "${ROFI_INFO#act:}"  ;;
        *)       die "invalid rofi entry data: $ROFI_INFO"
    esac
}

load_rofi() {
    local -r font="Hack Nerd Font 16"
    local -r theme="entry{placeholder:\"Search...\";} window{width:22%;}"

    rofi \
        -show sysmenu \
        -modes "sysmenu:$SELF" \
        -i \
        -format p \
        -theme-str "$theme" \
        -font "$font" \
        -kb-cancel "Control+g,Control+Escape" \
        -kb-custom-1 "Escape"
}

main() {
    local initial_menu=${1:-main}

    if [[ -z ${ROFI_RETV:-} ]]; then
        export INI_MENU="$initial_menu"
        load_rofi
        return
    fi

    case $ROFI_RETV in
        0)   render "${INI_MENU:-main}" ;;
        1)   handle_selection ;;
        10)  render_parent ;;
        *)   die "Unexpected Rofi return value: $ROFI_RETV" ;;
    esac
}

main "$@"
