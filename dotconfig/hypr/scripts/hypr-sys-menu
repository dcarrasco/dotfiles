#!/usr/bin/env bash

set -euo pipefail

declare -xr CONFIG_HOME=${XDG_CONFIG_HOME:-$HOME/.config}

TERMINAL=kitty
SCRIPT_PATH=$CONFIG_HOME/hypr/scripts
SELF=$SCRIPT_PATH/hypr-sys-menu
MENU_FILE=$SCRIPT_PATH/sys-menu.jsonc
MENU_ARROW_COLOR=

export PATH="$SCRIPT_PATH:$PATH"

die() {
    printf '[ERROR] %s\n' "$*" >&2
    notify-send -u critical -t 0 -i dialog-warning 'ERROR: hypr-sys-menu' "$*"
    exit 1
}

debug() {
    [[ ${HYPR_SYS_MENU_DEBUG:-false} == true ]] || return 0
    printf '[DEBUG] %s\n' "$*" >&2
}

exec_pgm() {
    coproc {
        "$@" > /dev/null 2>&1
    }
    exit 0
}

terminal() {
    local command=$*

    "$TERMINAL" --class hypr-terminal-float --title Fedora bash -c -- "$command"
}

present_terminal() {
    local command=$1

    terminal "hypr-show-logo; $command; hypr-show-done"
}

edit_file() {
    local file=$1

    notify-send -u low -i preferences-desktop 'Editing config file' "$file"
    cd "$(dirname "$file")" || exit 1
    "$TERMINAL" nvim "$file"
}

webapp() {
    local url=$1

    brave-browser --password-store=basic --new-window --app="$url"
}

entry() {
    local label=$1
    local action=$2
    local checked=${3:-false}

    [[ $checked == true ]] && label+=' '

    case "$action" in
        opt:* | menu:*)     menu_label "$label" ;;
        *)                  printf '%s' "$label" ;;
    esac

    printf '\0info\x1f%s\n' "$action"
}

title_case() {
    sed -E \
        -e 's/^([[:lower:]])/\U\1/'  \
        -e 's/-([[:lower:]])/ \U\1/g' \
        <<< "$1"
}

entries_bar_styles() {
    local menu_item=$1
    local current_style style
    local -a styles=()

    current_style="$(hypr-switch-bar-layout --get-style)"
    mapfile -t styles < <(hypr-switch-bar-layout --list-styles )

    for style in "${styles[@]}"; do
        local selected=false
        [[ $style == "$current_style" ]] && selected=true

        entry "${style^}" "act:$menu_item:$style" "$selected"
    done
}

entries_theme_colors() {
    local menu_item=$1
    local current_theme theme_name
    local -a themes=()

    current_theme="$(hypr-switch-colors --current)"
    mapfile -t themes < <(hypr-switch-colors --get-themes)

    for theme_name in "${themes[@]}"; do
        local selected=false
        [[ $theme_name == "$current_theme" ]] && selected=true

        entry "$(title_case "$theme_name")" "act:$menu_item:$theme_name" "$selected"
    done
}

entries_fonts() {
    local menu_item=$1
    local current_font font label selected
    local -a fonts=()

    current_font="$(hypr-switch-font --current)"
    mapfile -t fonts < <(hypr-switch-font --get-fonts)

    for font in "${fonts[@]}"; do
        selected=false
        [[ $font == "$current_font" ]] && selected=true
        label="<span size=\"small\" font_family=\"$font\">$font</span>"

        entry "$label" "act:$menu_item:$font" "$selected"
    done
}

checked_option() {
    local option=$1
    local checked=false

    case $option in
        bar_top)        [[ $(hypr-switch-bar-layout --get-position) == top ]]  && checked=true;;
        bar_bottom)     [[ $(hypr-switch-bar-layout --get-position) == bottom ]] && checked=true ;;
        bar_stacked)    [[ $(hypr-switch-bar-layout --get-stack) == stacked ]] && checked=true ;;
        bar_floating)   [[ $(hypr-switch-bar-layout --get-stack) == floating ]] && checked=true ;;
        pm_balanced)    [[ $(hypr-switch-power-mgmt --current) == balanced ]] && checked=true ;;
        pm_performance) [[ $(hypr-switch-power-mgmt --current) == performance ]] && checked=true ;;
        pm_eco)         [[ $(hypr-switch-power-mgmt --current) == eco ]] && checked=true ;;
        wifi)           [[ $(nmcli radio wifi) == enabled ]] && checked=true ;;
        bluetooth)      [[ $(hypr-bluetooth --state) == on ]] && checked=true ;;
        ctrlcaps)       hyprctl getoptions input:kb_options | grep -q swapcaps && checked=true ;;
        nightlight)     [[ -n $(pidof wlsunset) ]] && checked=true ;;
        *)              die "Checked option not defined"
    esac

    printf '%s' "$checked"
}

render_parent_menu() {
    local current_menu=${ROFI_DATA:-main}

    [[ $current_menu == 'main' ]] && exit 0

    local parent_menu=${current_menu%.*}
    [[ $parent_menu == "$current_menu" ]] && parent_menu='main'

    render "$parent_menu"
}

menu_query() {
    sed '/^[[:space:]]*\/\//d' "$MENU_FILE" |
        jq -r "$@" || die "menu json file not parseable: $MENU_FILE"
}

process_menu() {
    local menu=$1

    debug "process_menu: menu: $menu"

    # shellcheck disable=SC2016 # $menu is a jq variable.
    menu_query --arg menu "$menu" '
        to_entries[]
        | select(
            if $menu == "main" then
                (.key | contains(".") | not)
            else
                (.key | startswith($menu + ".")) and (.key | ltrimstr($menu + ".") | contains(".") | not)
            end
        )
        | [
            .key,
            (.value.icon // ""),
            (.value.label // ""),
            (.value.action // "" | tostring),
            (.value.options // ""),
            (.value.checked // "")
        ]
        | join("\u001e")'
}

menu_title() {
    local menu=$1

    # shellcheck disable=SC2016 # $menu is a jq variable.
    menu_query --arg menu "$menu" '.[$menu].label // empty'
}

menu_label() {
    local label=$1
    local menu_width=19
    local spaces arrow_color

    if [[ -z "$MENU_ARROW_COLOR" ]]; then
        arrow_color="$(sed -nE 's/[[:space:]]*foreground: (.*);/\1/p' "$XDG_CONFIG_HOME/rofi/themes/colors.rasi")"
        MENU_ARROW_COLOR="${arrow_color:0:7}44"
    fi

    if (( ${#label} <= menu_width )); then
        printf -v spaces '%*s' "$((menu_width - ${#label}))" ''
        label+=$spaces
    else
        label=${label:0:$menu_width}
    fi

    printf '%s<span color="%s"></span>' "$label" "$MENU_ARROW_COLOR"
}

render() {
    local menu_item=${1:-main}
    local title rows
    local selected=false
    local name icon label action options checked

    title=$(menu_title "$menu_item")
    rows=$(process_menu "$menu_item")

    printf '\0prompt\x1f%s\n' "${title:-Start}"
    printf '\0no-custom\x1ftrue\n'
    printf '\0markup-rows\x1ftrue\n'
    printf '\0data\x1f%s\n' "$menu_item"
    printf '\0use-hot-keys\x1ftrue\n'

    [[ -n "$rows" ]] || return 0

    while IFS=$'\x1e' read -r name icon label action options checked; do
        selected=false
        debug "RENDER: name: $name  icon: $icon  label: $label  action: $action  options: $options  checked: $checked"
        if [[ -n $options ]]; then
            entry "$icon  $label" "opt:$name" ""
        elif [[ -n $action ]]; then
            [[ -n "$checked" ]] && selected="$(checked_option "$checked")"
            entry "$icon  $label" "act:$name" "$selected"
        else
            entry "$icon  $label" "menu:$name" ""
        fi
    done <<< "$rows"
}

run_action() {
    local menu_item=$1
    local menu_key=${menu_item%%:*}
    local i action_text
    local -a action=()

    # shellcheck disable=SC2016 # $menu is a jq variable.
    action_text=$(menu_query --arg menu "$menu_key" '
        .[$menu].action
        |   if type != "array" then
                error("action must be an array")
            elif length == 0 then
                error("action must not be empty")
            elif (all(.[]; type == "string") | not) then
                error("action arguments must be string")
            elif .[0] == "" then
                error("action command must not be empty")
            else
                .[]
            end
    ') || die "invalid action: $menu_key"

    mapfile -t action <<< "$action_text"

    for i in "${!action[@]}"; do
        [[ ${action[$i]} == *'$'* ]] || continue
        action[i]=$(printf '%s' "${action[i]}" | envsubst) || die "cannot expand action: $menu_key"
    done

    if [[ $menu_item == *:* ]]; then
        action+=("${menu_item#*:}")
    fi

    debug "RUN ACTION: ${action[*]}"

    exec_pgm "${action[@]}"
}

render_options() {
    local menu_item=$1
    local options_cmd

    # shellcheck disable=SC2016 # $menu is a jq variable.
    options_cmd="entries_$(menu_query --arg menu "$menu_item" '.[$menu].options')"

    declare -F "$options_cmd" >/dev/null || die "invalid options function: $options_cmd"

    "$options_cmd" "$menu_item"
}

handle_selection() {
    local info="${ROFI_INFO:-}"

    case $info in
        menu:*)  render         "${info#menu:}" ;;
        act:*)   run_action     "${info#act:}"  ;;
        opt:*)   render_options "${info#opt:}"  ;;
        *)       die "invalid rofi entry data: $info"
    esac
}

load_rofi() {
    local -r font='Hack Nerd Font 16'
    local -r theme="entry{placeholder:\"Search...\";} window{${ROFI_LOCATION:-} width:calc (22% min 400px);}"

    rofi \
        -show sysmenu \
        -modes "sysmenu:$SELF" \
        -i \
        -format p \
        -theme-str "$theme" \
        -font "$font" \
        -kb-cancel "Control+g,Control+Escape" \
        -kb-custom-1 "Escape"
}

main() {
    debug "MAIN: n_param: $# ($*)"
    local initial_menu=main

    while [[ $# -gt 1 ]]; do
        case $1 in
            --location)
                ROFI_LOCATION="location:$2;"
                shift 2
                ;;
            --menu)
                initial_menu=$2
                shift 2
                ;;
        esac
    done

    debug "MAIN: ROFI_RETV: ${ROFI_RETV:-}"
    case ${ROFI_RETV:-load_rofi} in
        load_rofi)  export INI_MENU="$initial_menu"; load_rofi ;;
        0)          render "${INI_MENU:-main}" ;;
        1)          handle_selection ;;
        10)         render_parent_menu ;;
        *)          die "Unexpected Rofi return value: $ROFI_RETV" ;;
    esac
}

main "$@"
