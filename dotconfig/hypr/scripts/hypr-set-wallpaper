#!/bin/bash

WALLPAPER_CONFIG="$XDG_CONFIG_HOME/hypr/hyprpaper.conf"
wallpaper="/home/daniel/Imágenes/fondos pantalla/abstract/liquid/fluidic-glossy-gradient-background-purple-background-3840x2160-7641.jpg"

if [ -n "$1" ]; then
    wallpaper="$1"
fi

if [ -n "$wallpaper" ]; then
    # Cambia la configuración inicial del fondo de pantalla
    sed -i "s|\([[:space:]]*path =\).*|\1 $wallpaper|" "$WALLPAPER_CONFIG"

    # Ejecuta cambio de fondo en todas las pantalla
    hyprctl hyprpaper wallpaper "eDP-1,$wallpaper"
    hyprctl hyprpaper wallpaper "DP-8,$wallpaper"
    hyprctl hyprpaper wallpaper "DP-9,$wallpaper"

    notify-send -u low -i preferences-wallpaper "Set wallpaper" "${wallpaper##*/}"
fi
