#!/usr/bin/env bash

set -euo pipefail

SCRIPTS=$XDG_CONFIG_HOME/hypr/scripts
THEMES_DIR=$XDG_CONFIG_HOME/hypr/themes

get_themes() {
    find "$THEMES_DIR" -maxdepth 1 -type f -name '*.json' -printf '%f\n' | sed 's/\.json$//' | sort -u
}

set_theme() {
    local theme=$1

    if [[ -n "$theme" ]]; then
        hypr-generate-themes "${theme,,}"
        [[ $DESKTOP_SESSION == "bspwm" ]] && bspc wm --restart

        notify-send -u low -i preferences-desktop-color "Colors" "Change colors to $theme"
    fi
}


if [[ -z "${1:-}" ]]; then
    "$SCRIPTS/hypr-sys-menu" --menu style
else
    case "$1" in
        set | --set)                set_theme "$2" ;;
        current | --current)        "$SCRIPTS/hypr-state" --get-prop color ;;
        get-themes | --get-themes)  get_themes ;;
    esac
fi
