#!/bin/bash

set -euo pipefail

STATE_HOME=${XDG_STATE_HOME:-$HOME/.local/state}
THEME_STATE=$STATE_HOME/hypr/theme
THEMES_DIR=$XDG_CONFIG_HOME/hypr/themes

current_theme() {
    if [ -r "$THEME_STATE" ]; then
        IFS= read -r current < "$THEME_STATE"
        printf '%s' "$current"
    fi
}

get_themes() {
    find "$THEMES_DIR" -maxdepth 1 -type f -name '*.toml' -printf '%f\n' | sed 's/\.toml$//' | sort -u
}

set_theme() {
    local theme=$1

    if [ -n "$theme" ]; then
        hypr-generate-themes "${theme,,}"
        [[ $DESKTOP_SESSION == "bspwm" ]] && bspc wm --restart
        notify-send -u low "Colors" "Change colors to $theme"
    fi
}


if [[ -z "${1:-}" ]]; then
    "$XDG_CONFIG_HOME/hypr/scripts/hypr-sys-menu" "theme_colors"
else
    case "$1" in
        set|--set)
            set_theme "$2"
            ;;
        current|--current)
            current_theme
            ;;
        get-themes|--get-themes)
            get_themes
            ;;
    esac
fi
