#!/usr/bin/env bash

set -euo pipefail

readonly STATE_HOME=${XDG_STATE_HOME:-$HOME/.local/state}
readonly HYPR_STATE=$STATE_HOME/hypr-state.json

has_prop() {
    local prop="${1:-}"

    jq --arg prop "$prop" 'has($prop)' "$HYPR_STATE"
}

get_prop() {
    local prop="${1:-}"

    jq -r --arg prop "$prop" '.[$prop]' "$HYPR_STATE"
}

set_prop() {
    local prop="${1:-}"
    local value="${2:-}"
#
    tmp=$(mktemp)
    jq --arg prop "$prop" --arg value "$value" --sort-keys '.[$prop]=$value' "$HYPR_STATE" > "$tmp" && mv "$tmp" "$HYPR_STATE"
}

main() {
    [[ -e "$HYPR_STATE" ]] || printf '{}' > "$HYPR_STATE"

    case "${1:-}" in
        --get-prop)     get_prop "$2" ;;
        --set-prop)     set_prop "$2" "$3" ;;
    esac
}

main "$@"
