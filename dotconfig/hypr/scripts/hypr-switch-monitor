#!/usr/bin/env bash

set -euo pipefail

declare -xr CONFIG_HOME=${XDG_CONFIG_HOME:-$HOME/.config}

SCRIPT_PATH=$CONFIG_HOME/hypr/scripts
SELF=$SCRIPT_PATH/hypr-switch-monitor

declare -A OPTIONS=(
    [SET_PRI]='  Pantalla interna'
    [SET_SEC]='󰍹  Pantalla externa'
    [SET_DUP]=' 󰍹  Duplicar'
    [SET_EXT]=' 󰍹  Ampliar'
    [SET_OFF]='   Desactivar monitor'
    [SET_ON]='  Activar monitor'
    [SET_RESOL]='󰹑  Ajustar Resolucion'
    [SCALE_100]='  Escalar al 100%'
    [SCALE_125]='  Escalar al 125%'
    [SCALE_133]='  Escalar al 133%'
    [SCALE_150]='  Escalar al 150%'
    [SCALE_200]='  Escalar al 200%'
)

declare -a OPTIONS_ONE_MONITOR=(
    SET_RESOL
    SCALE_100
    SCALE_125
    SCALE_133
    SCALE_150
    SCALE_200
)

declare -a OPTIONS_MULTIPLE_MONITORS=(
    SET_PRI
    SET_SEC
    SET_DUP
    SET_EXT
)

die() {
    debug "ERROR: hypr-switch-monitor ****************"
    notify-send -u critical -t 0 -i dialog-warning 'ERROR: hypr-switch-monitor' "$*"
    exit 1
}

debug() {
    [[ ${HYPR_SWITCH_MONITOR_DEBUG:-false} == true ]] || return 0
    printf 'DEBUG: %s\n' "$*" >&2
}

exec_pgm() {
    coproc {
        "$@" > /dev/null 2>&1
    }
}

load_rofi() {
    local -r font='Hack Nerd Font 15'
    local -r theme='entry{placeholder:"Search...";} window{width:22%;}'

    rofi \
        -show sysmenu \
        -modes "sysmenu:$SELF" \
        -i \
        -format p \
        -theme-str "$theme" \
        -font "$font"
}

notify() {
    local message=$1

    notify-send -u low 'Pantalla' "$message"
}

hyprland_monitors() {
    hyprctl -j monitors all
}

count_monitors() {
    case $BACKEND in
        wayland)  hyprland_monitors | jq -r 'length' ;;
        x11)      xrandr -q | grep -c ' connected' ;;
    esac
}

count_enabled_monitors() {
    case $BACKEND in
        wayland)  hyprland_monitors | jq -r '[.[] | select(.disabled == false)] | length' ;;
        x11)      xrandr -q | grep -c ' connected' ;;
    esac
}

list_monitors() {
    debug "function: list_monitors"

    case $BACKEND in
        wayland)  hyprland_monitors | jq -r '.[].name' ;;
        x11)      xrandr -q | awk '$2 == "connected" { print $1 }' ;;
    esac
}

get_monitor_list() {
    local description icon

    debug 'function: render_monitor_list'

    case $BACKEND in
        wayland)
            for monitor in $(list_monitors); do
                description="$(get_monitor_property "$monitor" description)"
                [[ $monitor == "$MON_INT" ]] && icon='' || icon='󰍹'
                printf '%s  %s %s\n' "$icon" "$monitor" "$description"
            done
            ;;
        x11)
            xrandr -q | grep ' connected' | cut -d " " -f 1
            ;;
    esac
}

get_monitor_data() {
    local monitor=$1

    debug "function: get_monitor_data($monitor)"

    case $BACKEND in
        wayland)
            hyprland_monitors | jq -r --arg monitor "$monitor" '
                .[] | select(.name == $monitor)
                | [.name, "\(.width)x\(.height)", "\(.x)x\(.y)", .description, (.scale | tostring), (.disabled | tostring)]
                | @tsv'
            ;;
        x11)
            local resolution
            resolution="$(xrandr -q | grep "$monitor" | sed 's/primary //' | cut -d " " -f 3 | cut -d "+" -f 1)"

            printf '%s\t%s\t%s\t%s\t%s\t%s' "$monitor" "$resolution" unknown "$monitor" 1.0 false
            ;;
    esac
}

get_monitor_property() {
    local monitor=$1
    local property=$2
    local name res pos desc scale disabled

    debug "function: get_monitor_property($monitor, $property)"

    IFS=$'\t' read -r name res pos desc scale disabled < <(get_monitor_data "$monitor")

    case $property in
        name)           printf '%s' "$name" ;;
        resolution)     printf '%s' "$res" ;;
        position)       printf '%s' "$pos" ;;
        description)    printf '%s' "$desc" ;;
        scale)          printf '%s' "$scale" ;;
        disabled)       printf '%s' "$disabled" ;;
        *)              die "monitor property unknown: $property"
    esac
}

get_monitor_resolution_list() {
    local monitor=$1

    debug "function: get_monitor_resolution_list($monitor)"

    case $BACKEND in
        wayland)
            hyprland_monitors |
                jq -r --arg monitor "$monitor" '.[] | select(.name == $monitor) | .availableModes | .[] | split("@")[0]' |
                awk '!seen[$0]++'
            ;;
        x11)
            xrandr -q |
                awk -v monitor="$monitor" '{if ($1 ~ monitor) {print_now = 1} if (print_now==1 && $1 ~ /^[1-9]/) {print $1}}'
            ;;
    esac
}

set_monitor_hypr_lua() {
    local monitor=$1
    local property=$2
    local value=$3
    local curr_resolution curr_position curr_scale

    curr_resolution="$(get_monitor_property "$monitor" resolution)"
    curr_position="$(get_monitor_property "$monitor" position)"
    curr_scale="$(get_monitor_property "$monitor" scale)"

    case $property in
        scale)
            [[ $monitor == "$MON_INT" && $value = "1.5" ]] && value=1.458333

            hyprctl eval "hl.monitor({ output='$monitor', mode='$curr_resolution', position='$curr_position', scale=$value, disabled=false })"
            notify "Set scale for $monitor to $value"
            ;;
        disabled)
            hyprctl eval "hl.monitor({ output='$monitor', disabled=$value, mirror='' })"
            notify "Set $monitor $([[ $value == true ]] && printf 'disabled' || printf 'enabled')"
            ;;
        resolution)
            hyprctl eval "hl.monitor({ output='$monitor', mode='$value', position='$curr_position', scale=$curr_scale, disabled=false })"
            notify "Set resolution for $monitor to $value"
            ;;
        mirror)
            hyprctl eval "hl.monitor({ output='$monitor', mode='$value', position='$curr_position', scale=$curr_scale, disabled=false, mirror='$value' })"
            notify "Set mirror for $monitor to $value"
            ;;
        *)
            die "monitor hypr_lua property unknown: $property / $value"
            ;;
    esac
}

set_monitor_hypr_conf() {
    local monitor=$1
    local property=$2
    local value=$3

    local resolution position scale

    resolution="$(get_monitor_property "$monitor" resolution)"
    position="$(get_monitor_property "$monitor" position)"
    scale="$(get_monitor_property "$monitor" scale)"

    case $property in
        disabled)
            if [[ $value == true ]]; then
                hyprctl keyword monitor "$monitor,disable"
            else
                hyprctl keyword monitor "$monitor,$resolution,$position,$scale"
            fi
            ;;
        resolution)
            hyprctl keyword monitor "$monitor,$value,$position,$scale"
            ;;
        scale)
            [[ $monitor == "$MON_INT" && $value == 1.5 ]] && value=1.458333
            hyprctl keyword monitor "$monitor,$resolution,$position,$value"
            ;;
        mirror)
            hyprctl keyword monitor "$monitor,$resolution,$position,$scale,mirror,$value"
            ;;
        *)
            die "Propiedad Hyprland desconocida: $property"
            ;;
    esac
}

set_monitor_x11() {
    local monitor=$1
    local property=$2
    local value=$3
    local factor

    case $property in
        disabled)
            if [[ $value == true ]]; then
                xrandr --output "$monitor" --off
            elif [[ $monitor == "$MON_INT" ]]; then
                xrandr --output "$monitor" --auto
            else
                xrandr --output "$monitor" --auto --right-of "$MON_INT"
            fi
            ;;
        resolution)
            xrandr --output "$monitor" --mode "$value"
            ;;
        scale)
            case $value in
                1.0)    factor=1 ;;
                1.25)   factor=0.8 ;;
                1.33)   factor=0.751879 ;;
                1.5)    factor=0.666667 ;;
                2.0)    factor=0.5 ;;
                *)      die "Escala X11 no soportada: $value" ;;
            esac

            xrandr --output "$monitor" --scale "$factor"
            ;;
        mirror)
            xrandr --output "$monitor" --auto --same-as "$value"
            ;;
        *)
            die "Propiedad X11 desconocida: $property"
            ;;
    esac
}

set_monitor_property() {
    local monitor=$1
    local property=$2
    local value=$3

    debug "function: set_monitor_property($monitor, $property, $value)"

    case "$BACKEND:$HYPRCONF" in
        wayland:lua)    exec_pgm set_monitor_hypr_lua  "$monitor" "$property" "$value" ;;
        wayland:conf)   exec_pgm set_monitor_hypr_conf "$monitor" "$property" "$value" ;;
        x11:*)          exec_pgm set_monitor_x11       "$monitor" "$property" "$value" ;;
        *)              die "Backend desconocido $BACKEND:$HYPRCONF"
    esac
}

get_lid_state() {
    cat /proc/acpi/button/lid/LID0/state | cut -d ":" -f 2 | xargs
}

get_backend() {
    MON_INT=eDP
    BACKEND=x11
    HYPRCONF=conf

    debug "function: get_backend"

    if [[ -n ${HYPRLAND_INSTANCE_SIGNATURE:-} ]] && command -v hyprctl >/dev/null 2>&1; then
        BACKEND=wayland
        MON_INT=eDP-1
    fi

    if [[ $BACKEND == wayland && -f "$CONFIG_HOME/hypr/hyprland.lua" ]]; then
        HYPRCONF=lua
    fi

    debug "Backend: $BACKEND / Internal Monitor: $MON_INT / HyprConf: $HYPRCONF"
}

set_monitors_layout() {
    local profile=$1
    local monitor

    debug "function: apply_monitors_layout"

    while IFS= read -r monitor; do
        case $profile in
            main)
                set_monitor_property "$monitor" disabled \
                    "$([[ $monitor == "$MON_INT" ]] && printf false || printf true)"
                ;;
            secondary)
                set_monitor_property "$monitor" disabled \
                    "$([[ $monitor == "$MON_INT" ]] && printf true || printf false)"
                ;;
            extend)
                set_monitor_property "$monitor" disabled false
                ;;
            duplicate)
                if [[ $monitor == "$MON_INT" ]]; then
                    set_monitor_property "$monitor" disabled false
                else
                    set_monitor_property "$monitor" mirror "$MON_INT"
                fi
                ;;
            *)
                die "Unknown monitor layout profile: $profile"
                ;;

        esac
    done < <(list_monitors)
}

entry() {
    local label=$1
    local action=$2
    local checked=${3:-}

    debug "entry   label: $label  action: $action"

    [[ $checked  == true ]] && label+=' '

    printf '%s\0info\x1f%s\n' "$label" "$action"
}

disp_scale() {
    local scale=$1
    local disp=

    case $scale in
        1)          disp='100%' ;;
        1.25)       disp='125%' ;;
        1.3333334)  disp='133%' ;;
        1.4583334)  disp='150%' ;;
        1.5)        disp='150%' ;;
        2)          disp='200%' ;;
        *)          die "Scale unknown: $scale"
    esac

    printf '%s' "$disp"
}

render_resolution() {
    local monitor=$1
    local resolution
    local curr_res

    debug "function: render_resolution($monitor)"

    curr_res="$(get_monitor_property "$monitor" resolution)"

    while IFS= read -r resolution; do
        entry "$resolution" "RESOL:$resolution" "$([[ $curr_res == "$resolution" ]] && printf true)"
    done < <(get_monitor_resolution_list "$monitor")
}

render_multiple_monitor() {
    local monitor
    local -a options
    local -a monitor_options
    local opt

    debug 'function: render_multiple_monitor'

    printf '\0prompt\x1f%s\n'  'Monitor'
    printf '\0message\x1f%s\n' ""
    printf '\0data\x1f%s\n'    ""

    options=("${OPTIONS_MULTIPLE_MONITORS[@]}")
    for opt in "${options[@]}"; do
        entry "${OPTIONS[$opt]}" "$opt"
    done

    # render monitor list
    mapfile -t monitor_options < <(get_monitor_list)
    for opt in "${monitor_options[@]}"; do
        IFS=' ' read -r _ monitor _ <<< "$opt"
        entry "$opt" "SELECT:$monitor"
    done
}

render_one_monitor() {
    local monitor=${1:-}
    local monitor monitor_desc scale resolution is_disabled
    local opt

    debug "function: render_one_monitor($monitor)"

    [[ -n "$monitor" ]] || monitor="$(list_monitors)"
    scale="$(get_monitor_property "$monitor" scale)"
    resolution="$(get_monitor_property "$monitor" resolution)"
    is_disabled="$(get_monitor_property "$monitor" disabled)"

    monitor_desc=$(printf '%s: %s %s' \
        "$monitor" "$resolution" "$(disp_scale "$scale")")

    printf '\0prompt\x1f%s\n'  'Monitor'
    printf '\0message\x1f%s\n' "$monitor_desc"
    printf '\0data\x1f%s\n'    "$monitor"

    # render_monitor_enable "$monitor"
    if (( $(count_monitors) > 1 )) && [ "$(get_lid_state)" == open ]; then
        if [[ $is_disabled == false ]]; then
            if (( $(count_enabled_monitors) > 1 )); then
                debug "monitor $monitor disabled falso"
                entry "${OPTIONS[SET_OFF]}" "SET_OFF"
            fi
        else
            debug "monitor $monitor disabled true"
            entry "${OPTIONS[SET_ON]}" "SET_ON"
        fi
    fi

    if [[ $is_disabled == false ]]; then
        for opt in "${OPTIONS_ONE_MONITOR[@]}"; do
            local checked=''
            case "$(disp_scale "$scale")" in
                100%)   [[ $opt == SCALE_100 ]] && checked=true ;;
                125%)   [[ $opt == SCALE_125 ]] && checked=true ;;
                133%)   [[ $opt == SCALE_133 ]] && checked=true ;;
                150%)   [[ $opt == SCALE_150 ]] && checked=true ;;
                200%)   [[ $opt == SCALE_200 ]] && checked=true ;;
                *)      die "Displayed scale unknown"
            esac

            entry "${OPTIONS[$opt]}" "$opt" "$checked"
        done
    fi
}

handle_selection() {
    local monitor=${ROFI_DATA:-}

    debug "function: handle_selection($ROFI_INFO)"

    case $ROFI_INFO in
        SET_PRI)    set_monitors_layout main ;;
        SET_DUP)    set_monitors_layout duplicate ;;
        SET_EXT)    set_monitors_layout extend ;;
        SET_SEC)    set_monitors_layout secondary ;;

        SET_OFF)    set_monitor_property "$monitor" disabled true ;;
        SET_ON)     set_monitor_property "$monitor" disabled false ;;

        SCALE_100)  set_monitor_property "$monitor" scale 1.0 ;;
        SCALE_125)  set_monitor_property "$monitor" scale 1.25 ;;
        SCALE_133)  set_monitor_property "$monitor" scale 1.33 ;;
        SCALE_150)  set_monitor_property "$monitor" scale 1.5  ;;
        SCALE_200)  set_monitor_property "$monitor" scale 2.0  ;;
        RESOL:*)    set_monitor_property "$monitor" resolution "${ROFI_INFO#*:}" ;;

        SET_RESOL)  render_resolution "$monitor" ;;
        SELECT:*)   render_one_monitor "${ROFI_INFO#*:}" ;;

        act:setup.monitors)     render ;;

        *)          die "Selection unknown: $ROFI_INFO"
    esac

}

render() {
    local monitor_count
    monitor_count=$(count_monitors)

    debug "function: render"

    printf '\0no-custom\x1ftrue\n'

    case $monitor_count in
        0)  die "No monitors found" ;;
        1)  render_one_monitor ;;
        *)  render_multiple_monitor ;;
    esac
}

main() {
    # hack to call hypr-switch-monitor via hypr-sys-menu
    [[ ${1:-} == '--reset' ]] && ROFI_RETV=''

    debug "main -------------------"
    debug "ROFI_RETV ${ROFI_RETV:-}"
    debug "ROFI_INFO ${ROFI_INFO:-}"
    debug "ROFI_DATA ${ROFI_DATA:-}"

    get_backend

    if [[ -z ${ROFI_RETV:-} ]]; then
        load_rofi
        return
    fi

    case $ROFI_RETV in
        0)  render ;;
        1)  handle_selection ;;
        *)  die "ROFI_RETV unknown: $ROFI_RETV"
    esac
}

main "$@"

