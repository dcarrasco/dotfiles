#!/usr/bin/env bash

set -euo pipefail

die() {
    printf 'ERROR: %s\n' "$*" >&2
    notify-send -u critical -t 0 -i dialog-warning 'ERROR: hypr-switch-monitor' "$*"
    exit 1
}

debug() {
    [[ ${HYPR_SWITCH_MONITOR_DEBUG:-false} == true ]] || return 0
    printf 'DEBUG: %s\n' "$*" >&2
}

menu() {
    local options=$1
    local prompt=$2
    local message=${3:-}

    if [[ -n "$message" ]]; then
        printf '%s' "$options" | rofi -a 0:2 -dmenu -p "$prompt" -mesg "$message"
    else
        printf '%s' "$options" | rofi -dmenu -p "$prompt"
    fi
}

notify() {
    local message=$1

    notify-send -u low 'Pantalla' "$message"
}

hyprland_monitors() {
    hyprctl -j monitors all
}

count_monitors() {
    case $BACKEND in
        wayland)  hyprland_monitors | jq -r 'length' ;;
        x11)      xrandr -q | grep -c ' connected' ;;
    esac
}

count_enabled_monitors() {
    case $BACKEND in
        wayland)  hyprland_monitors | jq -r '[.[] | select(.disabled == false)] | length' ;;
        x11)      xrandr -q | grep -c ' connected' ;;
    esac
}

list_monitors() {
    case $BACKEND in
        wayland)  hyprland_monitors | jq -r '.[].name' ;;
        x11)      xrandr -q | awk '$2 == "connected" { print $1 }' ;;
    esac
}

get_monitor_list() {
    case $BACKEND in
        wayland)
            printf '%s\n%s\n%s\n%s\n' "$OPT_SET_MAIN" "$OPT_SET_DUP" "$OPT_SET_EXT" "$OPT_SET_SEC"

            for monitor in $(list_monitors); do
                local icon='  '
                [ $MON_INT != "$monitor" ] && icon='󰍹  '
                printf '%s %s %s' "$icon", "$monitor", "$(hyprland_monitor_property "$monitor" "description")" ;
            done
            ;;
        x11)
            xrandr -q | grep ' connected' | cut -d " " -f 1
            ;;
    esac
}

hyprland_monitor_property() {
    local monitor=$1
    local property=$2

    hyprland_monitors |
        jq -r --arg monitor "$monitor" --arg property "$property" \
            '.[] | select(.name == $monitor) | .[$property]'
}

get_monitor_data() {
    local monitor=$1

    case $BACKEND in
        wayland)
            MON_RES="$(hyprland_monitor_property "$monitor" "width")x$(hyprland_monitor_property "$monitor" "height")"
            MON_POS="$(hyprland_monitor_property "$monitor" "x")x$(hyprland_monitor_property "$monitor" "y")"
            MON_DESC=$(hyprland_monitor_property "$monitor" "description")
            MON_SCALE=$(hyprland_monitor_property "$monitor" "scale")
            MON_DISABLED=$(hyprland_monitor_property "$monitor" "disabled")
            MON_RES_LIST=$(hyprland_monitor_property "$monitor" "availableModes" | jq -r '.[] | split("@")[0]')
            ;;
        x11)
            MON_RES="$(xrandr -q | grep "$monitor" | sed 's/primary //' | cut -d " " -f 3 | cut -d "+" -f 1)"
            MON_POS='unknown'
            MON_DESC="$monitor"
            MON_SCALE=1.0
            MON_DISABLED="false"
            MON_RES_LIST="$(xrandr -q | awk -v monitor="$monitor" '{if ($1 ~ monitor) {print_now = 1} if (print_now==1 && $1 ~ /^[1-9]/) {print $1}}')"
            ;;
    esac
}

set_monitor_on() {
    local monitor=$1
    local resolution=$2
    local position=$3
    local scale=$4

    case $BACKEND in
        wayland)
            case $HYPRCONF in
                conf)  hyprctl keyword monitor "$monitor", "$resolution", "$position", "$scale" ;;
                lua)   hyprctl eval "hl.monitor({ output='$monitor', mode='$resolution', position='$position', scale=$scale, disabled=false})" ;;
            esac
            ;;
        x11)
            xrandr --output "$monitor" --right-of $MON_INT --auto
            ;;
    esac
    notify "Set pantalla $monitor on"
}

set_monitor_on_mirror() {
    local monitor=$1
    local resolution=$2
    local position=$3
    local scale=$4

    case $BACKEND in
        wayland)
            case $HYPRCONF in
                conf) hyprctl keyword monitor "$monitor", "$resolution", "$position", "$scale", mirror, "$MON_INT" ;;
                lua)  hyprctl eval "hl.monitor({ output='$monitor', mode='$resolution', position='$position', scale=$scale, mirror='$MON_INT'})" ;;
            esac ;;
        x11)
            xrandr --output "$monitor" --right-of "$MON_INT" --auto
            ;;
    esac
    notify "Set pantalla $monitor (mirror) on"
}

set_monitor_off() {
    local monitor=$1

    case $BACKEND in
        wayland)
            case $HYPRCONF in
                conf) hyprctl keyword monitor "$monitor", disable ;;
                lua)  hyprctl eval "hl.monitor({ output='$monitor', disabled=true})" ;;
            esac ;;
        x11)
            xrandr --output "$monitor" --off
            ;;
    esac
    notify "Set pantalla $monitor off"
}

set_resolution() {
    local monitor=$1
    local resolution=$2

    case $BACKEND in
        wayland) set_monitor_on "$monitor" "$resolution" "$MON_POS" "$MON_SCALE" ;;
        x11)     xrandr --output "$monitor" --mode "$resolution" ;;
    esac
    notify "Resolucion $monitor: $resolution"
}

set_scale() {
    local monitor=$1
    local scale=$2

    case $BACKEND in
        wayland)
            [[ $monitor == "$MON_INT" && $scale = "1.5" ]] && scale=1.458333
            set_monitor_on "$monitor" "$MON_RES" "$MON_POS" "$scale"
            ;;
        x11)
            case $scale in
                1.0)   xrandr --output "$monitor" --scale 1.0 ;;
                1.25)  xrandr --output "$monitor" --scale 0.8 ;;
                1.5)   xrandr --output "$monitor" --scale 0.666 ;;
                2.0)   xrandr --output "$monitor" --scale 0.5 ;;
                *)     die "Scale not supported: $scale"
            esac
            ;;
    esac
    notify "Escala $monitor: $scale"
}

get_lid_state() {
    cat /proc/acpi/button/lid/LID0/state | cut -d ":" -f 2 | xargs
}

switch_monitor_opt() {
    if (( $(count_monitors) > 1 )) && [ "$(get_lid_state)" = "open" ]; then
        if [[ "$MON_DISABLED" == 'false' ]]; then
            if (( $(count_enabled_monitors) > 1 )); then
                printf '%s' "$OPT_SET_MON_OFF"
            fi
        else
            printf '%s' "$OPT_SET_MON_ON"
        fi
    else
        printf ''
    fi
}

select_monitor() {
    local monitor

    monitor="$(get_monitor_list)"
    (( $(count_monitors) > 1 )) && menu "$monitor" "Seleccione monitor"
}

menu_options() {
    local switch_option
    local -a options=()

    switch_option="$(switch_monitor_opt)"
    [[ -n "$switch_option" ]] && options+=("$switch_option")

    options+=("$OPT_SET_RESOL" "$OPT_SCALE_100" "$OPT_SCALE_125" "$OPT_SCALE_133" "$OPT_SCALE_150" "$OPT_SCALE_200")

    printf '%s\n' "${options[@]}"
}

get_backend() {
    MON_INT='eDP'
    BACKEND='x11'
    HYPRCONF='conf'

    if [[ -n ${HYPRLAND_INSTANCE_SIGNATURE:-} ]] && command -v hyprctl >/dev/null 2>&1; then
        BACKEND="wayland"
        MON_INT='eDP-1'
    fi

    [[ -f $HOME/.config/hypr/hyprland.lua ]] && HYPRCONF='lua'

    debug "Backend: $BACKEND / Internal Monitor: $MON_INT / HyprConf: $HYPRCONF"
}

set_monitor_props() {
    MON=$1
    get_monitor_data "$MON"

    OPC=$(menu "$(menu_options)" "Monitor $MON" "Monitor: $MON_DESC ($MON_RES @ $MON_POS)")

    [ -z "$OPC" ] && exit 0

    case $OPC in
        "$OPT_SET_MON_OFF") set_monitor_off "$MON" ;;
        "$OPT_SET_MON_ON") set_monitor_on "$MON" "$MON_RES" "$MON_POS" "$MON_SCALE";;
        "$OPT_SET_RESOL")
            RES=$(menu "$MON_RES_LIST" "Resolucion $MON")
            [[ -n "$RES" ]] && set_resolution "$MON" "$RES"
            ;;
        "$OPT_SCALE_100") set_scale "$MON" 1.0 ;;
        "$OPT_SCALE_125") set_scale "$MON" 1.25 ;;
        "$OPT_SCALE_133") set_scale "$MON" 1.33 ;;
        "$OPT_SCALE_150") set_scale "$MON" 1.5 ;;
        "$OPT_SCALE_200") set_scale "$MON" 2.0 ;;
    esac
}

set_monitor_main() {
    for m in $(list_monitors); do
        get_monitor_data "$m"
        [[ $MON_INT == "$m" ]] && set_monitor_on "$m" "$MON_RES" "$MON_POS" "$MON_SCALE"
        [[ $MON_INT != "$m" ]] && set_monitor_off "$m"
    done
}

set_monitor_sec() {
    for m in $(list_monitors); do
        get_monitor_data "$m"
        [[ "$MON_INT" == "$m" ]] && set_monitor_off "$m"
        [[ "$MON_INT" != "$m" ]] && set_monitor_on "$m" "$MON_RES" "$MON_POS" "$MON_SCALE"
    done
}

set_monitor_dup() {
    for m in $(list_monitors); do
        get_monitor_data "$m"
        [[ "$m" == "$MON_INT" ]] && set_monitor_on "$m" "$MON_RES" "$MON_POS" "$MON_SCALE"
        [[ "$m" != "$MON_INT" ]] && set_monitor_on_mirror "$m" "$MON_RES" "$MON_POS" "$MON_SCALE"
    done
}

set_monitor_ext() {
    for m in $(list_monitors); do
        get_monitor_data "$m"
        set_monitor_on "$m" "$MON_RES" "$MON_POS" "$MON_SCALE"
    done
}

OPT_SET_MAIN='   Solo pantalla de PC'
OPT_SET_DUP='   Duplicado'
OPT_SET_EXT='  󰍹  Ampliar'
OPT_SET_SEC='󰍹   Solo segunda pantalla'
OPT_SET_MON_OFF='    Desactivar monitor'
OPT_SET_MON_ON='    Activar monitor'
OPT_SET_RESOL='󰹑    Cambiar resolucion'
OPT_SCALE_100='    Escalar al 100'
OPT_SCALE_125='    Escalar al 125'
OPT_SCALE_133='    Escalar al 133'
OPT_SCALE_150='    Escalar al 150'
OPT_SCALE_200='    Escalar al 200'


get_backend

if (( $(count_monitors) == 1 )); then
    set_monitor_props "$(list_monitors)"
else
    MON=$(select_monitor) || exit 0
    [ -n "$MON" ] || exit 0

    case $MON in
        "$OPT_SET_MAIN") set_monitor_main ;;
        "$OPT_SET_DUP") set_monitor_dup ;;
        "$OPT_SET_EXT") set_monitor_ext ;;
        "$OPT_SET_SEC") set_monitor_sec ;;
        *) set_monitor_props "$(printf '%s' "$MON" | cut -d " " -f 2)" ;;
    esac
fi

