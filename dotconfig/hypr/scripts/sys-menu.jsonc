{
    // ROOT
    "apps": { "icon": "󰀻", "label": "Apps", "action": "rofi -i -show drun -show-icons -theme layout-apps" },
    "search": { "icon": "", "label": "Search", "action": "hypr-search-home" },
    "style": { "icon": "", "label": "Style" },
    "learn": { "icon": "", "label": "Learn" },
    "trigger": { "icon": "󱓞", "label": "Trigger" },
    "setup": { "icon": "", "label": "Setup" },
    "update": { "icon": "", "label": "Update" },
    "about": { "icon": "", "label": "About", "action": "terminal fastfetch; hypr-show-done" },
    "system": { "icon": "", "label": "System" },

    // STYLE
    "style.bar_layout": { "icon": "", "label": "Bar Layout", "options": "bar_layout_entries", "action": "hypr-switch-bar-layout --set" },
    "style.colors": { "icon": "󰸌", "label": "Colors", "options": "theme_colors_entries", "action": "hypr-switch-colors --set" },
    "style.fonts": { "icon": "", "label": "Font", "options": "font_entries", "action": "hypr-switch-font --set" },
    "style.background": { "icon": "", "label": "Background", "action": "hypr-switch-wallpaper" },
    "style.random_bg": { "icon": "", "label": "Random Background", "action": "hypr-switch-wallpaper random" },
    "style.hyprland": { "icon": "", "label": "Hyprland", "action": "edit_file $CONFIG_HOME/hypr/lua/looknfeel.lua" },

    // LEARN
    "learn.keybindings": {"icon": "", "label": "Keybindings", "action": "hypr-show-keybinds"},
    "learn.omarchy": {"icon": "", "label": "Omarchy", "action": "webapp https://manuals.omamix.org/2/the-omarchy-manual"},
    "learn.hyprland": {"icon": "", "label": "Hyprland", "action": "webapp https://wiki.hypr.land/"},
    "learn.waybar": {"icon": "", "label": "Waybar", "action": "webapp https://github.com/Alexays/Waybar/wiki"},
    "learn.nerdfonts": {"icon": "", "label": "NerdFonts", "action": "webapp https://www.nerdfonts.com/cheat-sheet"},
    "learn.arch": {"icon": "󰣇", "label": "Arch", "action": "webapp https://wiki.archlinux.org/title/Main_page"},
    "learn.neovim": {"icon": "", "label": "Neovim", "action": "webapp https://www.lazyvim.org/keymaps"},
    "learn.bash": {"icon": "󱆃", "label": "Bash", "action": "webapp https://devhints.io/bash"},
    "learn.tmux": {"icon": "", "label": "Tmux", "action": "webapp https://tmuxcheatsheet.com"},

    // TRIGGER
    "trigger.capture": { "icon": "", "label": "Capture" },
    "trigger.toggle": { "icon": "", "label": "Toggle" },

    // CAPTURE
    "trigger.capture.screenshot": { "icon": "", "label": "Screenshot" },
    "trigger.capture.screenrecord": { "icon": "", "label": "Screenrecord" },
    "trigger.capture.color": { "icon": "", "label": "Color", "action": "hyprpicker -a" },

    // SCREENSHOT
    "trigger.capture.screenshot.reg2clip": { "icon": "󰩬", "label": "Region to clipboard", "action": "hypr-cmd-screenshot clipboard" },
    "trigger.capture.screenshot.reg2file": { "icon": "󰩬", "label": "Region to file", "action": "hypr-cmd-screenshot region" },
    "trigger.capture.screenshot.disp2clip": { "icon": "󰹑", "label": "Display to clipboard", "action": "hypr-cmd-screenshot clipboard" },
    "trigger.capture.screenshot.disp2file": { "icon": "󰹑", "label": "Display to file", "action": "hypr-cmd-screenshot file" },

    // SCREENRECORD
    "trigger.capture.screenrecord.region": { "icon": "󰩬", "label": "Region", "action": "$OMARCHY_BIN_PATH/omarchy-cmd-screenrecord" },
    "trigger.capture.screenrecord.display": { "icon": "󰹑", "label": "Display", "action": "$OMARCHY_BIN_PATH/omarchy-cmd-screenrecord output" },

    // TOGGLE
    "trigger.toggle.wifi": { "icon": "", "label": "WiFi", "action": "hypr-switch-wifi" },
    "trigger.toggle.bluetooth": { "icon": "󰂯", "label": "Bluetooth", "action": "hypr-bluetooth --toggle" },
    "trigger.toggle.pm": { "icon": "", "label": "Power Management" },
    "trigger.toggle.keyboard_layout": { "icon": "", "label": "Keyboard Layout", "action": "hypr-switch-keyboard-layout" },
    "trigger.toggle.keyboard_controlcaps": { "icon": "󰪛", "label": "Keyboard ControlCaps", "action": "hypr-switch-controlcaps" },
    "trigger.toggle.screensaver": { "icon": "󱄄", "label": "Screensaver", "action": "$OMARCHY_BIN_PATH/omarchy-launch-screensaver" },
    "trigger.toggle.nightlight": { "icon": "󰔎", "label": "Nightlight", "action": "hypr-switch-nightlight" },
    "trigger.toggle.idle_lock": { "icon": "󱫖", "label": "Idle Lock", "action": "$OMARCHY_BIN_PATH/omarchy-toggle-idle" },
    "trigger.toggle.top_bar": { "icon": "󰍜", "label": "Top Bar", "action": "pkill -SIGUSR1 waybar" },

    // POWER MANAGEMENT
    "trigger.toggle.pm.balanced": { "icon": "", "label": "Balanced", "action": "tuned-adm profile balanced" },
    "trigger.toggle.pm.balanced_battery": { "icon": "", "label": "Balanced Battery", "action": "tuned-adm profile balanced-battery" },
    "trigger.toggle.pm.performance": { "icon": "", "label": "Performance", "action": "tuned-adm profile throughput-performance" },
    "trigger.toggle.pm.powersaver": { "icon": "", "label": "Power Saver", "action": "tuned-adm profile powersave" },

    // SETUP
    "setup.configs": { "icon": "", "label": "Configs", "action": "hypr-edit-config" },
    "setup.audio": { "icon": "", "label": "Audio", "action": "terminal wiremix" },
    "setup.wifi": { "icon": "", "label": "Wifi", "action": "hypr-nmcli-rofi" },
    "setup.bluetooth": { "icon": "󰂯", "label": "Bluetooth", "action": "blueman-manager" },
    "setup.monitors": { "icon": "󰍹", "label": "Monitors", "action": "hypr-switch-monitor" },
    "setup.printers": { "icon": "󰐪", "label": "Printers", "action": "webapp http://localhost:631" },
    "setup.keybindings": { "icon": "", "label": "Keybindings", "action": "edit_file $CONFIG_HOME/hypr/lua/keybinds.lua" },
    "setup.input": { "icon": "", "label": "Input", "action": "edit_file $CONFIG_HOME/hypr/lua/input.lua" },
    "setup.fingerprint": { "icon": "󰈷", "label": "Fingerprint", "action": "$OMARCHY_BIN_PATH/omarchy-setup-fingerprint" },
    "setup.fido2": { "icon": "", "label": "Fido2", "action": "$OMARCHY_BIN_PATH/omarchy-setup-fido2" },

    // UPDATE
    "update.update": { "icon": "", "label": "Update", "action": "present_terminal hypr-do-update" },
    "update.install": { "icon": "󰉉", "label": "Install package", "action": "terminal hypr-pkg-install; hypr-show-done" },
    "update.remove": { "icon": "󰭌", "label": "Remove package", "action": "terminal hypr-pkg-remove; hypr-show-done" },

    // SYSTEM
    "system.lock": { "icon": "", "label": "Lock", "action": "hyprlock" },
    "system.logout": { "icon": "󰗽", "label": "Logout", "action": "loginctl terminate-user $USER" },
    "system.suspend": { "icon": "", "label": "Suspend", "action": "systemctl suspend" },
    "system.reboot": { "icon": "", "label": "Reboot", "action": "systemctl reboot" },
    "system.poweroff": { "icon": "󰐥", "label": "Power off", "action": "systemctl poweroff" }
}
