@import "colors.rasi"

window {
    location: center;
    anchor:   center;
    transparency: "real";
    border: 3px;
    border-color: @window-border;
    border-radius: 12px;
    height: calc(61% min 700px);
    width: calc(50% min 900px);
    margin: 0;
    spacing: 0;
    children:  [mainbox];
    orientation: horizontal;
    background-color: @bg-color;
}

mainbox {
    height: 60%;
    width:50%;
    spacing: 0;
    padding: 1em;
    children: [ inputbar, message, listview ];
}

// inputbar ------------------------------------------------------------------------------
inputbar {
    padding: 0 0 1em;
    spacing: 1em;
    children: [ prompt, entry ];
    // children: [ prompt, entry, case-indicator, num-filtered-rows, num-rows ];
}

prompt {
    /* simbolo de busqueda */
    font: "SF UI Display 20";
    text-color: @fg-prompt;
    vertical-align: 0.5;
    enabled: true;
}

entry {
    /* cuadro de texto para escribir */
    font: "SF UI Display 18";
    placeholder: "Buscar...";
    text-color: @foreground;
    vertical-align: 0.5;
    padding: 0.5em 1em;
    cursor: text;
    hide-cursor-on-empty: true;
    placeholder-color: @fg-placeholder;
    // background-color: @bg-prompt;
    border-radius: 12px;
    border: 1px;
    border-color: @fg-scrollbar;
}

case-indicator, num-rows, num-filtered-rows {
    /* Cuadro para incluir case-indicator */
    font: "SF Mono Display 11";
    text-color: @foreground;
    margin: 0;
    padding: 0;
    vertical-align: 0.5;
    enabled: true;
}

// message  ------------------------------------------------------------------------------
message {
    padding: 0em 0em 1em 0em;
}

textbox {
    padding: 1em 1em;
    border-radius: 12px;
    text-color: @foreground;
    background-color: @bg-textbox;
}

// listview  ------------------------------------------------------------------------------
listview {
    dynamic: false;
    border: 0;
    // scrollbar: true;
}

element {
    border-radius: 12px;
    padding: 0.5em 1em;
    vertical-align: 0.5;
    text-color: @foreground;
    spacing: 0.5em;
}

element active {
    border-color: @bg-selected;
    border: 2px;
}

element selected {
    text-color: @fg-selected;
    background-color: @bg-selected;
}

element-text {
    text-color: inherit;
    vertical-align: 0.5;
}

element-icon {
    vertical-align: 0.5;
    horizontal-align: 0.5;
    size: 1.4em ;
    padding: 0 0.5em 0 0;
}

scrollbar {
    handle-color: @fg-scrollbar;
    handle-rounded-corners: true;
    handle-width: 0.2em;
    padding: 0 0 0 0.5em;
}

// buttons  ------------------------------------------------------------------------------
button {
    padding: 5px;
    color: @foreground;
    horizontal-align: 0.5;

    border: 2px 0px 2px 2px;
    border-radius: 4px 0px 0px 4px;
    border-color: @foreground;
}

button selected normal {
    border: 2px 0px 2px 2px;
    border-color: @foreground;
}
